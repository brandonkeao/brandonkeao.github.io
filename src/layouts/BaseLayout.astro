---
import '../styles/global.css';
import Header from '../components/orbit/Header.astro';
import Footer from '../components/orbit/Footer.astro';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SiteHead {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-frame">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
