---
import '../styles/global.css';
import Header from '../components/orbit/Header.astro';
import Footer from '../components/orbit/Footer.astro';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-frame">
      <Header minimal />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
