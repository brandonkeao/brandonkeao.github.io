---
import OrbitStage from './orbit/OrbitStage.astro';
import Sheet from './orbit/Sheet.astro';
import Closing from './orbit/Closing.astro';
import TextLink from './orbit/TextLink.astro';

const linkedin = 'https://www.linkedin.com/in/brandonkeao/';
const problems = [
  { title: 'Teams pulling in different directions.', body: 'Make the problem clear, get people aligned, and stay with the team from the first hard decision through delivery.' },
  { title: 'Billing and platform complexity.', body: 'Understand how the work really happens across product, engineering, finance, and operations. Find the constraint and a practical way forward.' },
  { title: 'Using AI in everyday work.', body: 'Try AI on a real task, check the result, and keep what improves the work.' },
];
import MotionLine from './orbit/MotionLine.astro';
---

<OrbitStage set="home" size="large">
  <h1 slot="headline" class="t-display">Senior product leadership making outcomes move.</h1>
  <MotionLine slot="headline" kind="converge" />
  <p class="t-lead muted-g" style="max-width:480px">I help product teams build momentum toward better customer and business outcomes. That usually means untangling a difficult problem and getting people across functions moving together. I also help teams use AI on real work.</p>
  <div style="display:flex;gap:20px;align-items:center;margin-top:34px;flex-wrap:wrap">
    <a href="/contact" class="btn btn-ground">Let's talk</a>
    <a href={linkedin} class="link-ground" target="_blank" rel="noopener noreferrer">See my experience</a>
  </div>
</OrbitStage>

<Sheet id="fit" label="Working together">
  <div class="row">
    <div class="col"><h2 class="t-section">Consulting, fractional, or a full-time role.</h2></div>
    <div class="col stack divider-list">
      <div style="padding:24px 0">
        <h3 class="t-item">Consulting and fractional</h3>
        <p class="t-body muted-s" style="margin-top:8px">A difficult initiative, a product team that needs support, or a system that needs untangling. We start with the problem and decide together how I can help.</p>
        <p class="t-small muted-s" style="margin-top:10px">For smaller-team Head of Product work, I prefer to begin fractionally and learn about the fit together.</p>
      </div>
      <div style="padding:24px 0">
        <h3 class="t-item">Staff and Principal product roles</h3>
        <p class="t-body muted-s" style="margin-top:8px">Hands-on product leadership in a midsize or larger company, with broad problems to own and a team that works well together.</p>
        <p style="margin-top:16px"><TextLink href="/contact">Talk about the opportunity</TextLink></p>
      </div>
    </div>
  </div>
</Sheet>

<section class="section-ground" aria-labelledby="how-title">
  <div class="row">
    <div class="col"><h2 id="how-title" class="t-section">I stay close to the work.</h2></div>
    <div class="col">
      <p class="t-lead">I care about things that actually work.</p>
      <p class="t-body muted-g" style="margin-top:12px">My path runs from engineering and consulting through product leadership. I see things as systems and believe leadership comes from everywhere. I want useful products, clear decisions, and teams with room to do good work.</p>
      <div style="display:flex;gap:24px;margin-top:24px;flex-wrap:wrap">
        <TextLink href="/about" on="ground">More about me</TextLink>
        <TextLink href="/manager-readme" on="ground">My Manager README</TextLink>
      </div>
    </div>
  </div>
</section>

<Sheet id="the-work" label="The work">
  <div class="row">
    <div class="col">
      <h2 class="t-section">Some problems don't fit in one team.</h2>
      <p class="t-lead muted-s" style="margin-top:16px">That's where I like to work: connecting the customer, the system, and the people who need to make it happen.</p>
      <p style="margin-top:22px"><TextLink href={linkedin} external>See my experience on LinkedIn</TextLink></p>
    </div>
    <div class="col stack divider-list">
      {problems.map((p) => (
        <div style="padding:22px 0">
          <h3 class="t-item">{p.title}</h3>
          <p class="t-body muted-s" style="margin-top:8px">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</Sheet>

<Closing title="What needs to move? Tell me about the team, the problem, and where things are getting stuck." />
