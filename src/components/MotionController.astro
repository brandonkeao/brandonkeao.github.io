---
import '../styles/motion.css';
---

<script>
  // Only decorative marks animate. Content and each mark's final state are
  // rendered in HTML/CSS, including without JavaScript or reduced motion.
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const played = new WeakSet<Element>();
  let observer: IntersectionObserver | undefined;

  function stopMotion() {
    observer?.disconnect();
    observer = undefined;
  }

  function initMotion() {
    stopMotion();
    if (preference.matches) {
      document.querySelectorAll('[data-motion-play]').forEach((element) => {
        element.removeAttribute('data-motion-play');
      });
      return;
    }
    if (!('IntersectionObserver' in window)) return;

    observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer?.unobserve(entry.target);
        played.add(entry.target);
        entry.target.setAttribute('data-motion-play', '');
      }
    }, { threshold: 0.25 });

    document.querySelectorAll('[data-motion]').forEach((element) => {
      if (!played.has(element)) observer?.observe(element);
    });
  }

  preference.addEventListener('change', initMotion);
  document.addEventListener('astro:page-load', initMotion);
  document.addEventListener('astro:before-swap', stopMotion);
</script>
