---
const navLinks = [
  { href: '/#experience', label: 'Experience' },
  { href: '/services', label: 'Work With Me' },
  { href: '/bookshelf', label: 'Bookshelf' },
  { href: '/manager-readme', label: 'Manager README' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav class="container site-nav">
    <a
      href="/"
      class="site-brand"
      aria-label="Brandon Keao, home"
    >
      <span class="site-brand-mark" aria-hidden="true">BK</span>
      <span>Brandon Keao</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      <ul class="flex items-center gap-10">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={[
                "text-xs font-medium uppercase tracking-widest transition-colors",
                currentPath === link.href || currentPath.startsWith(link.href + '/')
                  ? "text-[var(--text-primary)]"
                  : "text-[var(--text-tertiary)] hover:text-[var(--text-primary)]"
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact" class="btn btn-primary nav-cta">Start a Conversation</a>
    </div>

    <div class="flex items-center md:hidden">
      <button
        id="mobile-menu-btn"
        class="menu-button"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span id="menu-label">Menu</span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden mobile-menu">
    <ul class="container py-6 flex flex-col gap-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              "block py-3 text-sm font-medium uppercase tracking-widest transition-colors",
              currentPath === link.href || currentPath.startsWith(link.href + '/')
                ? "text-[var(--text-primary)]"
                : "text-[var(--text-tertiary)] hover:text-[var(--text-primary)]"
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li><a href="/contact" class="block mt-4 btn btn-primary">Start a Conversation</a></li>
    </ul>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const label = document.getElementById('menu-label');

    btn?.addEventListener('click', () => {
      const isHidden = menu?.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isHidden));

      if (label) label.textContent = isHidden ? 'Menu' : 'Close';
    });
  }

  // Initialize on page load
  initMobileMenu();

  // Re-initialize after view transitions
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
