---
import { ViewTransitions } from 'astro:transitions';
import Analytics from './Analytics.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Proposal pages: keep out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = "Brandon Keao is a product leader, builder, and advisor helping teams build useful products, stronger systems, and lasting growth.",
  ogImage,
  noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---

<meta charset="utf-8" />
<!-- Lets CSS hold animated marks until their script runs; without JS they show as drawn.
     Also installs, once, a popstate hook ahead of Astro's router (its listener is registered
     first, so a page's own listener runs too late to stop it): a page that owns some history
     entries (Work with me's ?engagement=, ticket #15) sets window.__samePagePop, which returns
     true when it handled the Back/Forward in place. -->
<script is:inline>
  document.documentElement.classList.add('js');
  if (!window.__samePagePopHook) {
    window.__samePagePopHook = true;
    addEventListener('popstate', function (e) { var h = window.__samePagePop; if (h && h(e)) e.stopImmediatePropagation(); }, true);
  }
</script>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#2b2d29" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Preconnect to Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Orbit uses DM Sans only. The one italic (600) is for the Home headline's accent (#53). -->
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,600&display=swap"
  rel="stylesheet"
/>

<!-- SEO -->
<title>{title} | Brandon Keao</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

<!-- Twitter -->
<meta name="twitter:card" content={resolvedOgImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

<meta name="generator" content={Astro.generator} />

<!-- View Transitions -->
<ViewTransitions />

<!-- Analytics: PostHog, cookieless; nothing loads without PUBLIC_POSTHOG_KEY (website #1). -->
<Analytics />
