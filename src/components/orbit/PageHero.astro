---
// The shared page hero (ticket #34, designer review Phase 1): Bookshelf's page header made one
// component — the title, the lead, an optional body, and the page's own red mark run out as a
// line across the hero's lower edge, the width of the content column, separating it from the content below
// (Brandon, 2026-10-13, after Alicia: "a long line throughout the whole screen", "a grounding
// point in the header … keep it out longer"). Each page keeps its own motif on the line, so the
// heroes share a structure without becoming one template (Work with me: `formation`; Bookshelf:
// `books`). The line draws in once with its mark (MotionLine's own observer) and then stays;
// reduced motion and no-JS readers see it drawn. It is flat: no glow underlay.
// Spacing and measure live in CSS (the old inline max-widths moved here).
import MotionLine from './MotionLine.astro';

type Kind = 'momentum' | 'map' | 'align' | 'principles' | 'blocks' | 'blueprint' | 'chain' | 'books' | 'exchange' | 'formation' | 'connect' | 'converge' | 'build';
interface Props {
  title: string;
  /** The page's motif on the hero line; omit it for a hero with no line (Manager README, #85). */
  mark?: Kind;
  lead?: string;
  class?: string;
  /** The title's last words, set in italic and the on-ground red, on their own line at desktop
   *  (Home, #53; Brandon, 2026-10-14: "color and font treatments to add depth to the main
   *  positioning statement"). Must be the end of `title`; the page's <title> stays the sentence. */
  accent?: string;
}
const { title, mark, lead, class: extra, accent } = Astro.props;
// No mark, no line: no rule, motif, traveller or arrowhead (Manager README; Brandon, 2026-10-20:
// "Remove the redline animation for the Manager README page."). The header's own bottom padding
// (--space-hero-step) then sits between the lead and the sheet.
const accented = !!accent && title.endsWith(accent);
const head = accented ? title.slice(0, -accent!.length).trimEnd() : title;
// `align` is drawn as one stretched SVG across the whole line: its three strands run across the
// first ~28% of the line before merging (Brandon, #41), and the centre line runs on to the
// arrowhead at the right edge. Every
// other motif sits at the title's left edge on a full-width rule at its own baseline.
const stretched = mark === 'align';
// `principles` (About, #45) is also drawn across the whole line, by MotionLine itself.
const fullWidth = mark === 'principles';
// An optional `aside` slot (About's portrait, ticket #39; Home's "The role I play" callout, #53)
// sits beside the title and lead, above the line. Without it the markup is unchanged. The aside
// follows the text in the source, so readers meet the title, the lead and the actions first (#53's
// verification: it used to come first); phones still place it beside the title, by explicit grid
// placement, and desktop puts it right.
const hasAside = Astro.slots.has('aside');
// Every rule-based line ends in an open chevron at the column's right edge, invisible while the
// line draws and resolving in its last 0.2 s (#55; Brandon, 2026-10-14: "For all the red line
// versions, it should end in an arrow shape at the end of the annimation."). The stretched align
// and principles marks draw their own. `chain` (Home, #53) also launches the line: the scene plays
// first, then the rule sets out from the scene's exit with the traveller ahead of it.
const launches = mark === 'chain';
---

<header class:list={['page-header', 'page-hero', extra]} data-page-hero>
  {hasAside ? (
    <div class="page-hero-top">
      <div class="page-hero-main">
        <h1 class="t-page-title">{head}{accented && <>{' '}<em class="page-hero-accent">{accent}</em></>}</h1>
        {lead && <p class="t-lead muted-g page-lead page-hero-lead">{lead}</p>}
        <slot />
      </div>
      <div class="page-hero-aside"><slot name="aside" /></div>
    </div>
  ) : (
    <>
      <h1 class="t-page-title">{head}{accented && <>{' '}<em class="page-hero-accent">{accent}</em></>}</h1>
      {lead && <p class="t-lead muted-g page-lead page-hero-lead">{lead}</p>}
      <slot />
    </>
  )}
  {mark && <div class:list={['hero-line', `hero-line--${mark}`]} aria-hidden="true">
    {stretched
      ? <MotionLine kind="align" stretch mergeAt={0.28} />
      : fullWidth
      ? <MotionLine kind="principles" />
      : <><span class="hero-rule"></span><MotionLine kind={mark} />{launches && <span class="hero-traveller"></span>}<svg class="hero-arrow" viewBox="0 0 8 14" width="8" height="14" fill="none" focusable="false"><path d="m1 1 6 6-6 6" /></svg></>}
  </div>}
</header>

<style is:global>
  /* The lead's measure, formerly inline on each page. Widened from 720px so the lead takes fewer
     lines (ticket #47; Brandon, 2026-10-14: "extend wider and not break so soon"). */
  .page-hero-lead { max-width: 960px; }
  /* The title's accent: italic, the on-ground red, its own line at desktop (#53). */
  .page-hero-accent { font-style: italic; color: var(--accent-on-ground); }
  @media (min-width: 861px) { .page-hero-accent { display: block; } }
  /* With an aside: text left, aside right, top-aligned; the line still runs beneath both. */
  .page-hero-top { display: flex; align-items: flex-start; gap: 56px; }
  .page-hero-main { flex: 1; min-width: 0; }
  .page-hero-aside { flex: none; }
  /* The line spans the content column — from the title's left edge to the right edge of the
     nav's "Let's talk" button — not the window (Brandon, 2026-10-13, #36: "wayyy to long"). */
  .hero-line { position: relative; margin: 32px 0 0; height: 40px; color: var(--accent-on-ground); }
  .hero-line .motion-line { margin-top: 0; }
  /* A motif on the rule sits at the title's left edge, which is the line's own left edge. */
  .hero-line:not(.hero-line--align) .motion-line { position: relative; }
  /* The rule sits on the motif's own baseline (the shelf for books and build, the centre for
     the line marks), drawn once from the left with the motif. */
  .hero-line { --rule-y: 20px; }
  .hero-line--books, .hero-line--build { --rule-y: 36px; }
  .hero-rule { position: absolute; left: 0; right: 0; top: calc(var(--rule-y) - 0.75px); height: 1.5px; background: currentColor; opacity: 0.65; transform-origin: 0 50%; }
  /* blocks, blueprint and chain (Portfolio, Playbooks, Home; #38, #53) are 430 × 60 scenes, taller
     than the 40px line: the line takes the scene's height and the rule sits on its ground (y 56 of
     60), which `--rule-y` carries so the arrowhead and traveller follow it. */
  .hero-line--blocks, .hero-line--blueprint, .hero-line--chain { height: auto; --rule-y: calc(100% * 56 / 60); }
  /* The arrowhead at the end of every rule-based line (#55): hidden while armed, resolved in the
     draw's last 0.2 s (the rule draws in 1.1 s; chain's launches at 0.92 s and draws in 0.95 s). */
  .hero-arrow { position: absolute; right: -1px; top: calc(var(--rule-y) - 7px); width: 8px; height: 14px; overflow: visible; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  /* chain (Home, #53): the scene launches the line. The rule starts at the scene's exit (206 of
     430, scaled with the scene) and sets out at the last domino's cue, 0.92 s, with the traveller
     ahead of it and the arrowhead resolving at the column's edge. The line is a size container so
     the traveller's distance is plain CSS (cqw); `--hero-exit` uses % (a left offset), `--hero-exit-cq`
     the same length in cqw (inside a transform, where % would be the dot's own width). */
  .hero-line--chain { container-type: inline-size; --hero-exit: calc(min(430px, 100%) * 0.479); --hero-exit-cq: calc(min(430px, 100cqw) * 0.479); }
  .hero-line--chain .hero-rule { left: var(--hero-exit); }
  .hero-line--exchange { --hero-exit: min(228px, 82%); }
  .hero-line--exchange .hero-rule { left: var(--hero-exit); }
  /* Formation (#73): a separate rule beneath all eight ships, never a nose-level exit.
     The scene scales down only below 280px; its baseline follows that scaling. */
  .hero-line--formation { height: auto; --rule-y: calc(100% * 86 / 96); }
  .hero-traveller { position: absolute; left: var(--hero-exit); top: calc(var(--rule-y) - 3.5px); width: 7px; height: 7px; margin-left: -3.5px; border-radius: 50%; background: currentColor; opacity: 0; }
  /* The motif's own short shelf or ground would double the rule's tint where they overlap. */
  .hero-line--books .motion-line > .ml-draw.ml-soft:first-child,
  .hero-line--build .motion-line > .ml-draw.ml-soft:first-child,
  .hero-line--blocks .mlx-ground, .hero-line--blueprint .mlx-ground, .hero-line--chain .mlx-ground { display: none; }
  /* Flat: the stretched mark's soft glow underlay is dropped in the hero (designer review:
     "very minimal", "a little bit flatter"). */
  .hero-line .mls-glow { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-line:has(.motion-line[data-motion-armed]:not([data-motion-play])) .hero-rule { transform: scaleX(0); }
    .hero-line:has(.motion-line[data-motion-play]) .hero-rule { animation: hero-rule-draw 1100ms cubic-bezier(0.33, 0, 0.2, 1) both; }
    .hero-line:has(.motion-line[data-motion-armed]:not([data-motion-play])) .hero-arrow { opacity: 0; }
    .hero-line:has(.motion-line[data-motion-play]) .hero-arrow { animation: hero-resolve 200ms ease-out 920ms both; }
    /* chain: the rule, traveller and arrowhead wait for the scene (0.92 s), then draw in 0.95 s. */
    .hero-line--chain:has(.motion-line[data-motion-play]) .hero-rule { animation: hero-rule-draw 950ms cubic-bezier(0.33, 0, 0.2, 1) 920ms both; }
    .hero-line--chain:has(.motion-line[data-motion-play]) .hero-traveller { animation: hero-travel 950ms cubic-bezier(0.33, 0, 0.2, 1) 920ms forwards; }
    .hero-line--chain:has(.motion-line[data-motion-play]) .hero-arrow { animation-delay: 1690ms; }
    .hero-line--exchange:has(.motion-line[data-motion-play]) .hero-rule { animation-duration: 950ms; animation-delay: 620ms; }
    .hero-line--exchange:has(.motion-line[data-motion-play]) .hero-arrow { animation-delay: 1370ms; }
    /* Formation's third beat (#86): the underline draws once the eight have organized, and the
       terminal arrow waits for the complete rule. The beat lengths live in FormationMark. */
    .hero-line--formation:has(.motion-line[data-motion-play]) .hero-rule { animation: hero-rule-draw var(--mlf-t-rule) ease-in-out calc(var(--mlf-t-drift) + var(--mlf-t-organize)) both; }
    .hero-line--formation:has(.motion-line[data-motion-play]) .hero-arrow { animation: hero-resolve var(--mlf-t-arrow) ease-out calc(var(--mlf-t-drift) + var(--mlf-t-organize) + var(--mlf-t-rule)) both; }
  }
  @keyframes hero-rule-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes hero-travel { 0% { opacity: 1; transform: translateX(0); } 90% { opacity: 1; transform: translateX(calc(100cqw - var(--hero-exit-cq) - 9px)); } 100% { opacity: 0; transform: translateX(calc(100cqw - var(--hero-exit-cq) - 9px)); } }
  @keyframes hero-resolve { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 860px) {
    .hero-line { margin-top: 24px; }
    /* Phones: the aside sits right of the title, which starts where every other page's does; the
       lead runs full width below both. A grid row, not a float: the row is at least the aside's
       height, so the title rewrapping when the web font swaps in does not move what follows. */
    .page-hero-top { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0 16px; }
    .page-hero-main { display: contents; }
    .page-hero-main > * { grid-column: 1 / -1; }
    .page-hero-main > h1 { grid-column: 1; grid-row: 1; }
    .page-hero-aside { grid-column: 2; grid-row: 1; padding-top: 4px; }
  }
</style>
