---
// One heading pattern for a section: a sentence-case eyebrow, the section title, an optional lead.
// Works on the ground and on a sheet; colours follow the surface. The eyebrow is a caption
// (13/500, muted) so it reads as a section marker, apart from item meta (13/400, faint).
// The default slot follows the lead (Home v2 puts the About portrait there).
interface Props { eyebrow: string; title: string; id?: string; lead?: string }
const { eyebrow, title, id, lead } = Astro.props;
---

<header class="section-head">
  <p class="t-caption section-eyebrow">{eyebrow}</p>
  <h2 class="t-section" id={id}>{title}</h2>
  {lead && <p class="t-lead section-lead">{lead}</p>}
  <slot />
</header>

<style is:global>
  .section-head { max-width: 460px; }
  .section-eyebrow { font-weight: 500; color: var(--on-ground-muted); margin-bottom: 12px; }
  .section-lead { margin-top: 16px; color: var(--on-ground-muted); }
  .sheet .section-eyebrow, .sheet .section-lead { color: var(--on-sheet-muted); }
</style>
