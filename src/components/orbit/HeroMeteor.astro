---
// Home only: a meteor streaks across under the headline and leaves a solid red line the
// full width of the copy column, keeps its heading, then bends late as the planet's gravity
// pulls it in (Brandon, 2026-10-07), shedding embers, and lands
// with a flash and two ripples (Brandon, 2026-10-06). The line stays as the resting
// state. Plays once per page view; with reduced motion or no JavaScript the line is
// simply there.
---

<span class="hero-streak" aria-hidden="true"></span>

<script>
  let cleanup: (() => void) | undefined;

  function launch() {
    cleanup?.();
    cleanup = undefined;
    const line = document.querySelector<HTMLElement>('.hero-streak');
    const hero = document.querySelector<HTMLElement>('.orbit-hero');
    const stage = hero?.querySelector<HTMLElement>('.map-stage');
    if (!line || !hero || !stage) return;
    const show = () => line.setAttribute('data-drawn', '');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('offsetPath' in document.documentElement.style)) { show(); return; }

    let cancelled = false;
    const made: HTMLElement[] = [];
    cleanup = () => { cancelled = true; made.forEach((n) => n.remove()); show(); };

    // The planet's centre and radius on screen, once the renderer publishes them; without a live
    // scene, where the close-up poster's planet sits (right-anchored), never the copy.
    const planetAt = () => {
      const s = stage.getBoundingClientRect();
      const cs = getComputedStyle(stage);
      const closeup = stage.hasAttribute('data-closeup');
      const cx = parseFloat(cs.getPropertyValue('--center-x')) || (closeup ? s.width * 0.86 : s.width / 2);
      const cy = parseFloat(cs.getPropertyValue('--center-y')) || (closeup ? s.height * 0.47 : s.height / 2);
      const r = parseFloat(cs.getPropertyValue('--center-r')) || (closeup ? s.height * 0.38 : Math.min(s.width, s.height) / 6);
      return { x: s.left + cx, y: s.top + cy, r };
    };

    const go = () => {
      if (cancelled) return;
      const h = hero.getBoundingClientRect();
      const l = line.getBoundingClientRect();
      const y = l.top + l.height / 2 - h.top;
      // The line is still scaled to 0 here, so take its layout width, not its painted box.
      const x0 = l.left - h.left;
      const x1 = x0 + line.offsetWidth;
      const p = planetAt();
      const cx = p.x - h.left, cy = p.y - h.top, r = p.r;
      // Gravity, not a launch (Brandon 2026-10-07: "continue with the momentum straight and then
      // curve as it gets pulled into the planet's gravity and ultimately hits the planet").
      // The head keeps the line's heading past the copy, then bends late, with growing curvature,
      // and strikes the limb that faces its approach.
      let path: string;
      let tx: number, ty: number;
      const room = cx - r - x1;
      if (room > 80) {
        // Desktop: the planet is ahead, level with the line. The head keeps the line's heading for
        // a long run, then falls in a bend that tightens toward the end and strikes the lower-left
        // limb, the side facing its approach.
        const fall = Math.min(Math.max(y + r * 0.6, cy - r * 0.5), cy + r * 0.72);
        ty = fall;
        tx = cx - Math.sqrt(Math.max(0, r * r - (ty - cy) ** 2)) * 0.97;
        const xs = x1 + (tx - x1) * 0.42;
        const d = Math.hypot(tx - xs, ty - y);
        // The first handle stays on the heading (momentum); the second sits close to the impact
        // along the final, steeper heading (about 50 degrees down), so the curvature grows late.
        const c1x = xs + d * 0.6;
        const c2x = tx - d * 0.2 * 0.64, c2y = ty - d * 0.2 * 0.77;
        path = `M ${x0} ${y} L ${xs} ${y} C ${c1x} ${y} ${c2x} ${c2y} ${tx} ${ty}`;
      } else {
        // Phones: the planet sits under the end of the line. The head runs off the end of the
        // line and the pull bends it down onto the planet's face.
        tx = Math.min(x1 - 12, cx + r * 0.4);
        ty = y + Math.max(48, (cy - y) * 0.95);
        const d = Math.hypot(tx - x1, ty - y);
        const c1x = Math.min(x1 + d * 0.3, h.width - 4);
        path = `M ${x0} ${y} L ${x1} ${y} C ${c1x} ${y} ${tx + d * 0.18} ${ty - d * 0.4} ${tx} ${ty}`;
      }
      const lineLen = x1 - x0;
      let total = 0;
      try {
        const probe = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        probe.setAttribute('d', path);
        total = probe.getTotalLength();
      } catch { /* estimated below */ }
      if (!(total > lineLen)) total = lineLen + Math.hypot(tx - x1, ty - y) * 1.15;
      const lineShare = lineLen / total;

      // Timing follows the path: constant speed while the line is laid (momentum), then the head
      // speeds up as it falls in (from v to about 2v), so the bend reads as a pull, not a launch.
      const v = Math.max(0.4, lineLen / 950); // px per ms
      const tIn = 110, t1 = lineLen / v, t2 = Math.max(260, (total - lineLen) / (1.45 * v));
      const D = tIn + t1 + t2;
      const kIn = tIn / D, kLine = (tIn + t1) / D;
      const dIn = (v * tIn) / total;
      const FALL = 'cubic-bezier(0.3, 0.2, 0.7, 0.4)';

      const ride = (scale?: [number, number, number]) => [
        { offsetDistance: '0%', opacity: 0, easing: 'linear', ...(scale && { transform: `scaleX(${scale[0]})` }) },
        { offsetDistance: `${dIn * 100}%`, opacity: 1, offset: kIn, easing: 'linear', ...(scale && { transform: `scaleX(${scale[1]})` }) },
        { offsetDistance: `${lineShare * 100}%`, opacity: 1, offset: kLine, easing: FALL, ...(scale && { transform: `scaleX(${scale[1]})` }) },
        { offsetDistance: '100%', opacity: 1, ...(scale && { transform: `scaleX(${scale[2]})` }) },
      ];

      const meteor = document.createElement('div');
      meteor.className = 'meteor';
      meteor.style.offsetPath = `path('${path}')`;
      hero.appendChild(meteor);
      made.push(meteor);
      const run = meteor.animate(ride([0.4, 1, 1.5]), { duration: D, fill: 'forwards' });

      // The line is laid down behind the head: its right edge tracks the meteor exactly,
      // because both use the same keyframe offsets and linear timing along the line.
      line.animate([
        { transform: 'scaleX(0)', easing: 'linear' },
        { transform: `scaleX(${Math.min((v * tIn) / lineLen, 1)})`, offset: kIn, easing: 'linear' },
        { transform: 'scaleX(1)', offset: kLine },
        { transform: 'scaleX(1)' },
      ], { duration: D, fill: 'forwards' }).finished.then(show).catch(show);

      // Embers: a hidden core follows the head; small sparks are shed from it and fade.
      const core = document.createElement('div');
      core.className = 'meteor-core';
      core.style.offsetPath = meteor.style.offsetPath;
      hero.appendChild(core);
      made.push(core);
      const coreRun = core.animate(ride(), { duration: D, fill: 'forwards' });
      let lastEmber = 0;
      const shed = (now: number) => {
        if (cancelled || coreRun.playState === 'finished') return;
        const q = ((coreRun.currentTime as number) ?? 0) / D;
        if (q > 0.05 && q < 0.96 && now - lastEmber > 45) {
          lastEmber = now;
          const c = core.getBoundingClientRect();
          const hr = hero.getBoundingClientRect();
          const e = document.createElement('div');
          e.className = 'meteor-ember';
          e.style.left = `${c.left + c.width / 2 - hr.left}px`;
          e.style.top = `${c.top + c.height / 2 - hr.top}px`;
          hero.appendChild(e);
          const dx = (Math.random() - 0.5) * 22, dy = 6 + Math.random() * 16;
          const size = 0.6 + Math.random() * 0.8;
          e.animate([
            { transform: `translate(-50%, -50%) scale(${size})`, opacity: 0.95 },
            { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(0.15)`, opacity: 0 },
          ], { duration: 650 + Math.random() * 350, easing: 'cubic-bezier(0.2, 0.6, 0.4, 1)', fill: 'forwards' }).finished.then(() => e.remove()).catch(() => e.remove());
        }
        requestAnimationFrame(shed);
      };
      requestAnimationFrame(shed);

      run.finished.then(() => {
        meteor.remove();
        core.remove();
        if (cancelled) return;
        const at = (n: HTMLElement) => { n.style.left = `${tx}px`; n.style.top = `${ty}px`; hero.appendChild(n); made.push(n); return n; };
        const flash = at(Object.assign(document.createElement('div'), { className: 'meteor-flash' }));
        // The splash (Brandon: "2 or 3x more prominent"): a big glow, three ripples, and a burst of sparks.
        flash.animate([
          { transform: 'translate(-50%, -50%) scale(0.3)', opacity: 0 },
          { transform: 'translate(-50%, -50%) scale(1)', opacity: 0.95, offset: 0.2 },
          { transform: 'translate(-50%, -50%) scale(1.35)', opacity: 0 },
        ], { duration: 1100, easing: 'ease-out', fill: 'forwards' }).finished.then(() => flash.remove());
        [0, 160, 340].forEach((delay, i) => {
          const ring = at(Object.assign(document.createElement('div'), { className: 'meteor-ripple' }));
          ring.animate([
            { transform: 'translate(-50%, -50%) scale(0.15)', opacity: [1, 0.75, 0.5][i] },
            { transform: `translate(-50%, -50%) scale(${[2.4, 3.2, 4][i]})`, opacity: 0 },
          ], { duration: 1300, delay, easing: 'cubic-bezier(0.2, 0.6, 0.3, 1)', fill: 'both' }).finished.then(() => ring.remove());
        });
        for (let k = 0; k < 14; k++) {
          const spark = at(Object.assign(document.createElement('div'), { className: 'meteor-ember meteor-spark' }));
          const a = (k / 14) * Math.PI * 2 + Math.random() * 0.4;
          const d = (70 + Math.random() * 90) * (matchMedia('(max-width: 860px)').matches ? 0.45 : 1);
          spark.animate([
            { transform: 'translate(-50%, -50%) scale(1.4)', opacity: 1 },
            { transform: `translate(calc(-50% + ${Math.cos(a) * d}px), calc(-50% + ${Math.sin(a) * d}px)) scale(0.2)`, opacity: 0 },
          ], { duration: 800 + Math.random() * 500, easing: 'cubic-bezier(0.1, 0.7, 0.3, 1)', fill: 'forwards' }).finished.then(() => spark.remove());
        }
      }).catch(() => {});
    };

    // Start when the scene is ready (so the target is the real planet), within 2.5s.
    if (stage.classList.contains('is-ready')) { setTimeout(go, 150); return; }
    const mo = new MutationObserver(() => { if (stage.classList.contains('is-ready')) { mo.disconnect(); clearTimeout(fallback); setTimeout(go, 150); } });
    mo.observe(stage, { attributes: true, attributeFilter: ['class'] });
    const fallback = setTimeout(() => { mo.disconnect(); go(); }, 2500);
    const prev = cleanup;
    cleanup = () => { prev(); mo.disconnect(); clearTimeout(fallback); };
  }

  document.addEventListener('astro:page-load', launch);
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
</script>

<style is:global>
  .orbit-hero { position: relative; }
  /* The line the meteor leaves: solid brand red on the ground, the full width of the copy column. */
  .hero-streak { display: block; width: 100%; height: 4.5px; margin-top: 28px; border-radius: 3px; background: var(--accent-on-ground); transform-origin: 0 50%; }
  /* Hidden until the meteor lays it down; shown at once without JS or with reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .js .hero-streak:not([data-drawn]) { transform: scaleX(0); }
  }
  .meteor {
    position: absolute; left: 0; top: 0; z-index: 6; pointer-events: none;
    width: 140px; height: 9px;
    clip-path: polygon(0 50%, 100% 0, 100% 100%);
    offset-rotate: auto; offset-anchor: 100% 50%; transform-origin: 100% 50%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent-on-ground) 70%, transparent));
  }
  .meteor::after {
    content: ''; position: absolute; right: -7px; top: 50%; width: 15px; height: 15px; margin-top: -7.5px; border-radius: 50%;
    background: #ffe1de; box-shadow: 0 0 10px 3px var(--accent-on-ground), 0 0 30px 8px color-mix(in srgb, var(--accent-on-ground) 45%, transparent);
  }
  .meteor-core { position: absolute; left: 0; top: 0; width: 2px; height: 2px; offset-anchor: 50% 50%; pointer-events: none; visibility: hidden; }
  /* The splash sits under the copy (z 2) and over the scene, so text always reads on top. */
  .meteor-flash, .meteor-ripple, .meteor-spark { z-index: 1 !important; }
  .meteor-spark { width: 7px; height: 7px; }
  /* Phones: the planet sits behind the headline, so the splash stays planet-sized. */
  @media (max-width: 860px) {
    .meteor-flash { width: 200px; height: 200px; }
    .meteor-ripple { width: 52px; height: 52px; border-width: 3px; }
    .meteor-spark { width: 5px; height: 5px; }
  }
  .meteor-ember { position: absolute; z-index: 6; pointer-events: none; width: 5px; height: 5px; border-radius: 50%; background: #ffd0cb; box-shadow: 0 0 6px 1px var(--accent-on-ground); }
  .meteor-flash { position: absolute; z-index: 5; pointer-events: none; width: 450px; height: 450px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, #ffe1de 60%, transparent) 0%, color-mix(in srgb, var(--accent-on-ground) 55%, transparent) 22%, transparent 66%); }
  .meteor-ripple {
    position: absolute; z-index: 6; pointer-events: none; width: 110px; height: 110px; border-radius: 50%;
    border: 4px solid var(--accent-on-ground); box-shadow: 0 0 24px color-mix(in srgb, var(--accent-on-ground) 60%, transparent), inset 0 0 18px color-mix(in srgb, var(--accent-on-ground) 40%, transparent);
  }
</style>
