---
// Home only: a meteor streaks across under the headline and leaves a solid red line the
// full width of the copy column, then arcs into the planet, shedding embers, and lands
// with a flash and two ripples (Brandon, 2026-10-06). The line stays as the resting
// state. Plays once per page view; with reduced motion or no JavaScript the line is
// simply there.
---

<span class="hero-streak" aria-hidden="true"></span>

<script>
  let cleanup: (() => void) | undefined;
  const DURATION = 2400;
  const EASING = 'cubic-bezier(0.45, 0.05, 0.35, 1)';

  function launch() {
    cleanup?.();
    cleanup = undefined;
    const line = document.querySelector<HTMLElement>('.hero-streak');
    const hero = document.querySelector<HTMLElement>('.orbit-hero');
    const stage = hero?.querySelector<HTMLElement>('.map-stage');
    if (!line || !hero || !stage) return;
    const show = () => line.setAttribute('data-drawn', '');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('offsetPath' in document.documentElement.style)) { show(); return; }

    let cancelled = false;
    const made: HTMLElement[] = [];
    cleanup = () => { cancelled = true; made.forEach((n) => n.remove()); show(); };

    // Aim at the planet's upper-left limb once the renderer publishes its centre;
    // fall back to the stage centre if the scene is slow or unavailable.
    const target = () => {
      const s = stage.getBoundingClientRect();
      const cs = getComputedStyle(stage);
      const cx = parseFloat(cs.getPropertyValue('--center-x')) || s.width / 2;
      const cy = parseFloat(cs.getPropertyValue('--center-y')) || s.height / 2;
      const r = parseFloat(cs.getPropertyValue('--center-r')) || Math.min(s.width, s.height) / 6;
      return { x: s.left + cx - r * 0.92, y: s.top + cy - r * 0.38 };
    };

    const go = () => {
      if (cancelled) return;
      const h = hero.getBoundingClientRect();
      const l = line.getBoundingClientRect();
      const y = l.top + l.height / 2 - h.top;
      // The line is still scaled to 0 here, so take its layout width, not its painted box.
      const x0 = l.left - h.left;
      const x1 = x0 + line.offsetWidth;
      const t = target();
      const tx = t.x - h.left, ty = t.y - h.top;
      // Run the full line, then bend toward the planet.
      const c1x = Math.min(x1 + Math.max(60, (tx - x1) * 0.45), h.width - 8);
      const path = `M ${x0} ${y} L ${x1} ${y} C ${c1x} ${y} ${tx - 40} ${ty + 30} ${tx} ${ty}`;
      const lineLen = x1 - x0;
      const total = lineLen + Math.hypot(tx - x1, ty - y) * 1.15;
      const lineShare = lineLen / total;

      const ride = (scale?: [number, number, number, number]) => [
        { offsetDistance: '0%', opacity: 0, ...(scale && { transform: `scaleX(${scale[0]})` }) },
        { offsetDistance: '2%', opacity: 1, offset: 0.04, ...(scale && { transform: `scaleX(${scale[1]})` }) },
        { offsetDistance: `${lineShare * 100}%`, opacity: 1, offset: 0.36, ...(scale && { transform: `scaleX(${scale[2]})` }) },
        { offsetDistance: '88%', opacity: 1, offset: 0.8, ...(scale && { transform: `scaleX(${scale[3]})` }) },
        { offsetDistance: '100%', opacity: 0, ...(scale && { transform: 'scaleX(0.3)' }) },
      ];

      const meteor = document.createElement('div');
      meteor.className = 'meteor';
      meteor.style.offsetPath = `path('${path}')`;
      hero.appendChild(meteor);
      made.push(meteor);
      const run = meteor.animate(ride([0.4, 0.6, 1, 1.5]), { duration: DURATION, easing: EASING, fill: 'forwards' });

      // The line is laid down behind the head: its right edge tracks the meteor exactly,
      // because both use the same keyframe offsets and easing.
      const at2 = (0.02 * total) / lineLen;
      line.animate([
        { transform: 'scaleX(0)' },
        { transform: `scaleX(${Math.min(at2, 1)})`, offset: 0.04 },
        { transform: 'scaleX(1)', offset: 0.36 },
        { transform: 'scaleX(1)' },
      ], { duration: DURATION, easing: EASING, fill: 'forwards' }).finished.then(show).catch(show);

      // Embers: a hidden core follows the head; small sparks are shed from it and fade.
      const core = document.createElement('div');
      core.className = 'meteor-core';
      core.style.offsetPath = meteor.style.offsetPath;
      hero.appendChild(core);
      made.push(core);
      const coreRun = core.animate(ride(), { duration: DURATION, easing: EASING, fill: 'forwards' });
      let lastEmber = 0;
      const shed = (now: number) => {
        if (cancelled || coreRun.playState === 'finished') return;
        const p = ((coreRun.currentTime as number) ?? 0) / DURATION;
        if (p > 0.05 && p < 0.92 && now - lastEmber > 45) {
          lastEmber = now;
          const c = core.getBoundingClientRect();
          const hr = hero.getBoundingClientRect();
          const e = document.createElement('div');
          e.className = 'meteor-ember';
          e.style.left = `${c.left + c.width / 2 - hr.left}px`;
          e.style.top = `${c.top + c.height / 2 - hr.top}px`;
          hero.appendChild(e);
          const dx = (Math.random() - 0.5) * 22, dy = 6 + Math.random() * 16;
          const size = 0.6 + Math.random() * 0.8;
          e.animate([
            { transform: `translate(-50%, -50%) scale(${size})`, opacity: 0.95 },
            { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(0.15)`, opacity: 0 },
          ], { duration: 650 + Math.random() * 350, easing: 'cubic-bezier(0.2, 0.6, 0.4, 1)', fill: 'forwards' }).finished.then(() => e.remove()).catch(() => e.remove());
        }
        requestAnimationFrame(shed);
      };
      requestAnimationFrame(shed);

      run.finished.then(() => {
        meteor.remove();
        core.remove();
        if (cancelled) return;
        const at = (n: HTMLElement) => { n.style.left = `${tx}px`; n.style.top = `${ty}px`; hero.appendChild(n); made.push(n); return n; };
        const flash = at(Object.assign(document.createElement('div'), { className: 'meteor-flash' }));
        flash.animate([
          { transform: 'translate(-50%, -50%) scale(0.4)', opacity: 0 },
          { transform: 'translate(-50%, -50%) scale(1)', opacity: 0.75, offset: 0.25 },
          { transform: 'translate(-50%, -50%) scale(1.3)', opacity: 0 },
        ], { duration: 700, easing: 'ease-out', fill: 'forwards' }).finished.then(() => flash.remove());
        [0, 180].forEach((delay, i) => {
          const ring = at(Object.assign(document.createElement('div'), { className: 'meteor-ripple' }));
          ring.animate([
            { transform: 'translate(-50%, -50%) scale(0.2)', opacity: i ? 0.6 : 0.9 },
            { transform: `translate(-50%, -50%) scale(${i ? 3.4 : 2.6})`, opacity: 0 },
          ], { duration: 1000, delay, easing: 'ease-out', fill: 'both' }).finished.then(() => ring.remove());
        });
      }).catch(() => {});
    };

    // Start when the scene is ready (so the target is the real planet), within 2.5s.
    if (stage.classList.contains('is-ready')) { setTimeout(go, 150); return; }
    const mo = new MutationObserver(() => { if (stage.classList.contains('is-ready')) { mo.disconnect(); clearTimeout(fallback); setTimeout(go, 150); } });
    mo.observe(stage, { attributes: true, attributeFilter: ['class'] });
    const fallback = setTimeout(() => { mo.disconnect(); go(); }, 2500);
    const prev = cleanup;
    cleanup = () => { prev(); mo.disconnect(); clearTimeout(fallback); };
  }

  document.addEventListener('astro:page-load', launch);
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
</script>

<style is:global>
  .orbit-hero { position: relative; }
  /* The line the meteor leaves: solid brand red on the ground, the full width of the copy column. */
  .hero-streak { display: block; width: 100%; height: 4.5px; margin-top: 28px; border-radius: 3px; background: var(--accent-on-ground); transform-origin: 0 50%; }
  /* Hidden until the meteor lays it down; shown at once without JS or with reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .js .hero-streak:not([data-drawn]) { transform: scaleX(0); }
  }
  .meteor {
    position: absolute; left: 0; top: 0; z-index: 6; pointer-events: none;
    width: 140px; height: 9px;
    clip-path: polygon(0 50%, 100% 0, 100% 100%);
    offset-rotate: auto; offset-anchor: 100% 50%; transform-origin: 100% 50%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent-on-ground) 70%, transparent));
  }
  .meteor::after {
    content: ''; position: absolute; right: -7px; top: 50%; width: 15px; height: 15px; margin-top: -7.5px; border-radius: 50%;
    background: #ffe1de; box-shadow: 0 0 10px 3px var(--accent-on-ground), 0 0 30px 8px color-mix(in srgb, var(--accent-on-ground) 45%, transparent);
  }
  .meteor-core { position: absolute; left: 0; top: 0; width: 2px; height: 2px; offset-anchor: 50% 50%; pointer-events: none; visibility: hidden; }
  .meteor-ember { position: absolute; z-index: 6; pointer-events: none; width: 5px; height: 5px; border-radius: 50%; background: #ffd0cb; box-shadow: 0 0 6px 1px var(--accent-on-ground); }
  .meteor-flash { position: absolute; z-index: 5; pointer-events: none; width: 180px; height: 180px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent-on-ground) 55%, transparent) 0%, transparent 65%); }
  .meteor-ripple {
    position: absolute; z-index: 6; pointer-events: none; width: 44px; height: 44px; border-radius: 50%;
    border: 2px solid var(--accent-on-ground); box-shadow: 0 0 12px color-mix(in srgb, var(--accent-on-ground) 50%, transparent);
  }
</style>
