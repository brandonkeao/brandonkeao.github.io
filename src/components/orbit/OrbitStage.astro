---
// Orbit hero: the accepted living-map renderer (src/lib/orbit) behind page copy.
// The planet is the outcome; three moons are the ways in, each with three steps.
// Server-rendered markup works without JavaScript: poster image, chips and copy.
// The renderer loads lazily once the stage is visible and the browser is idle.
//
// Slots: `headline` (the h1) and the default slot (lead, actions, proof line).
// On narrow screens the order becomes headline, orbit, then the rest.
// `still`: the stage starts paused; choosing a way in still flies.
// No on-page pause control (Brandon, 2026-10-13: "We should also remove the pause button
// option", superseding D3): reduced motion is the stop (posters, a static stage). The stage
// still pauses itself offscreen, in a hidden tab and on context loss.
// `controls`: "none" makes the orbit decorative (no chips, moons not clickable:
// Home and Consulting, Brandon 2026-10-06); "stage" overlays the chip row on the orbit; "copy" puts it in the left
// column under the text, where it still drives the orbit (Work with me).
// `sheet`: the id of a sheet holding [data-orbit-title], [data-orbit-body] and
// [data-orbit-steps], which follows the selected way in.
// `scene` (ticket #16): host a collection hero scene (src/lib/orbit/collection-scene.ts)
// instead of the orbital map: Portfolio's Flight record or Playbooks' Maneuver. It shares
// the poster, the no-WebGL / reduced-motion fallback and the context-loss
// handling; it is always decorative and has no chips. Reduced motion never starts it: the
// poster is the still frame.
import { SETS, type OrbitSet } from '../../lib/orbit/orbit-data';
import type { CollectionKind } from '../../lib/orbit/collection-scene';

interface Props { set?: OrbitSet; scene?: CollectionKind; size?: 'closeup' | 'xl' | 'large' | 'small'; sheet?: string; still?: boolean; controls?: 'none' | 'stage' | 'copy'; speed?: number }
const { set = 'home', scene, size = 'large', sheet, still = false, speed = 1 } = Astro.props;
const controls = scene ? 'none' : (Astro.props.controls ?? 'stage');
const ways = SETS[set];
const closeup = size === 'closeup';
const poster = scene
  ? { desktop: `/images/orbit/${scene}-desktop.jpg`, mobile: `/images/orbit/${scene}-mobile.jpg` }
  : closeup
  ? { desktop: '/images/orbit/home-closeup-desktop.jpg', mobile: '/images/orbit/home-closeup-mobile.jpg' }
  : set === 'home'
    ? { desktop: '/images/orbit/home-desktop.jpg', mobile: '/images/orbit/home-mobile.jpg' }
    : { desktop: '/images/orbit/work-desktop.jpg', mobile: '/images/orbit/work-mobile.jpg' };
---

<section class:list={['orbit-hero', `orbit-hero--${size}`, closeup && 'orbit-hero--xl']}>
  <div class="hero-copy">
    <div class="hero-headline"><slot name="headline" /></div>
    <div class="hero-rest">
      <slot />
      <!-- Copy-column controls (Brandon, 2026-10-12 round 6): the three ways stay up as the
           one persistent switcher. No way back to the Overview (Brandon, 2026-10-12 round 14:
           visitors switch directly; the Overview is the pre-selection state only). No pause chip
           (Brandon, 2026-10-13). No steps or context caption here; they stay in markup only
           because the script expects them. -->
      {controls === 'copy' && (
        <div class="engagement-dock engagement-dock--copy" role="group" aria-label="Ways to work together" data-dock>
          <p class="dock-context" data-context hidden></p>
          {ways.map((w, i) => (
            <button class="engagement-chip" type="button" data-id={w.id} aria-pressed="false">
              <i class={`dot dot-${i + 1}`} aria-hidden="true"></i>{w.name}
            </button>
          ))}
          <span class="dock-steps" data-steps hidden></span>
        </div>
      )}
    </div>
  </div>
  <div class="map-stage" data-orbit={set} data-stage-scene={scene} data-sheet={sheet} data-still={still ? '' : undefined} data-static={controls === 'none' ? '' : undefined} data-speed={speed} data-closeup={closeup ? '' : undefined} data-mode="overview">
    <picture class="stage-poster">
      <source media="(max-width: 860px)" srcset={poster.mobile} />
      <img src={poster.desktop} alt="" width="840" height="700" decoding="async" fetchpriority={size === 'small' ? 'auto' : 'high'} />
    </picture>
    <div class="scene-host"></div>
    <!-- Page-supplied stage layers (e.g. the Work with me surface landings, ticket #10). -->
    <slot name="stage" />
    <!-- No visible text over the planet (Brandon, 2026-10-06); the title stays for screen readers. -->
    <div class="sr-only" aria-live="polite">
      <h2 id="map-current-title" tabindex="-1" data-title>Your outcome</h2>
    </div>
    <!-- The one control row (Brandon, 2026-10-06): ways in, or Back and the chosen way's steps.
         No page passes controls="stage" since round 6 (2026-10-12); kept, not deleted. -->
    {(controls === 'stage' || controls === 'none') && (
    <div class="engagement-dock" role="group" aria-label="Ways to work together" data-dock hidden={controls === 'none'}>
      <p class="dock-context" data-context hidden></p>
      <button class="engagement-chip" type="button" data-back hidden>← Back</button>
      {ways.map((w, i) => (
        <button class="engagement-chip" type="button" data-id={w.id} aria-pressed="false">
          <i class={`dot dot-${i + 1}`} aria-hidden="true"></i>{w.name}
        </button>
      ))}
      <span class="dock-steps" data-steps hidden></span>
    </div>
    )}
  </div>
</section>

<script>
  import { SETS, useSet, type CategoryId, type OrbitSet } from '../../lib/orbit/orbit-data';
  import type { MapController } from '../../lib/orbit/map-scene';
  import { navigate } from 'astro:transitions/client';

  import type { CollectionHandle, CollectionKind } from '../../lib/orbit/collection-scene';

  type Mode = 'overview' | 'entering' | 'collection' | 'leaving';
  let teardown: (() => void) | undefined;

  /* ---- shared by both scene types: the probe, the fallback, the lazy load ---- */
  function hasWebGL() {
    const probe = document.createElement('canvas');
    const gl = probe.getContext('webgl2') || probe.getContext('webgl');
    gl?.getExtension('WEBGL_lose_context')?.loseContext();
    return !!gl;
  }
  /** No WebGL, a failed load or a lost context: the poster stays (or returns). */
  const fallBack = (stage: HTMLElement) => { stage.classList.add('is-fallback'); stage.classList.remove('is-ready'); };
  /** Run `fn` once the stage is on screen and the browser is idle; returns a cancel. */
  function whenSeen(stage: HTMLElement, fn: () => void) {
    const idle = (f: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(f, { timeout: 1500 }) : setTimeout(f, 200);
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { seen.disconnect(); idle(fn); }
    });
    seen.observe(stage);
    return () => seen.disconnect();
  }
  /** A collection hero scene (ticket #16): decorative, one context, no controls. */
  function initCollection(stage: HTMLElement) {
    const host = stage.querySelector<HTMLElement>('.scene-host')!;
    const kind = stage.dataset.stageScene as CollectionKind;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let handle: CollectionHandle | null = null;
    let disposed = false;
    // Off production, ?scene-t=<seconds|poster> freezes the clock (poster capture).
    let freeze: number | 'poster' | undefined;
    if (!/(^|\.)brandonkeao\.com$/.test(location.hostname)) {
      const v = new URLSearchParams(location.search).get('scene-t');
      if (v === 'poster') freeze = 'poster';
      else if (v && !Number.isNaN(parseFloat(v))) freeze = parseFloat(v);
    }
    async function load() {
      if (disposed) return;
      if (!hasWebGL()) { fallBack(stage); return; }
      try {
        const { createCollectionScene } = await import('../../lib/orbit/collection-scene');
        if (disposed) return;
        handle = createCollectionScene(host, kind, {
          onReady() {
            if (disposed) return;
            stage.classList.add('is-ready');
          },
          onFailure() { fallBack(stage); },
        }, freeze);
      } catch {
        fallBack(stage);
      }
    }
    // Reduced motion: the poster is the still frame; no renderer, no context.
    const cancel = reduced ? () => {} : whenSeen(stage, load);
    return () => {
      disposed = true;
      cancel();
      handle?.dispose();
      handle = null;
    };
  }

  function init() {
    teardown?.();
    teardown = undefined;
    const stage = document.querySelector<HTMLElement>('.map-stage[data-orbit]');
    if (!stage) return;
    if (stage.dataset.stageScene) { teardown = initCollection(stage); return; }

    const set = (stage.dataset.orbit as OrbitSet) || 'home';
    const ways = SETS[set];
    const hero = stage.closest('.orbit-hero') ?? stage;
    const q = <T extends HTMLElement>(s: string, root: ParentNode = hero) => root.querySelector<T>(s)!;
    const host = q('.scene-host');
    const title = q('[data-title]');
    const dock = q('[data-dock]');
    // Only the unused controls="stage" dock still has a Back button (round 14 retired "↑ Overview").
    const back = hero.querySelector<HTMLButtonElement>('[data-back]');
    const stepsEl = q('[data-steps]');
    const context = q('[data-context]');
    const chips = [...hero.querySelectorAll<HTMLButtonElement>('.engagement-chip[data-id]')];
    let stepsFor: CategoryId | null = null;
    const sheet = stage.dataset.sheet ? document.getElementById(stage.dataset.sheet) : null;

    const ctl = new AbortController();
    const opts = { signal: ctl.signal };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let mode: Mode = 'overview';
    let current: CategoryId | null = null;
    let pending: CategoryId | null = null;
    let token = 0;
    const still = stage.hasAttribute('data-still');
    const decorative = stage.hasAttribute('data-static');
    let paused = reduced || still;
    let map: MapController | null = null;
    let disposed = false;

    function renderSheet(id: CategoryId) {
      if (!sheet) return;
      const w = ways.find((x) => x.id === id)!;
      const t = sheet.querySelector('[data-orbit-title]');
      const b = sheet.querySelector('[data-orbit-body]');
      const list = sheet.querySelector('[data-orbit-steps]');
      if (t) t.textContent = w.name;
      if (b) b.textContent = w.summary;
      list?.replaceChildren(...w.items.map((it, i) => {
        const li = document.createElement('li');
        const n = document.createElement('span');
        n.textContent = String(i + 1).padStart(2, '0');
        const s = document.createElement('strong');
        const a = document.createElement('a');
        a.href = it.href;
        a.textContent = it.title;
        s.append(a);
        const p = document.createElement('p');
        p.textContent = it.description;
        li.append(n, s, p);
        return li;
      }));
    }

    // The chosen way's steps as chips; each opens the step's page, like its moon label.
    function renderSteps(id: CategoryId) {
      if (stepsFor === id) return;
      stepsFor = id;
      const i = ways.findIndex((x) => x.id === id);
      stepsEl.replaceChildren(...ways[i].items.map((it) => {
        const a = document.createElement('a');
        a.className = 'engagement-chip';
        a.href = it.href;
        const dot = document.createElement('i');
        dot.className = `dot dot-${i + 1}`;
        dot.setAttribute('aria-hidden', 'true');
        a.append(dot, it.title);
        return a;
      }));
    }

    function render() {
      const w = ways.find((x) => x.id === current);
      const inWay = !!(w && map && (mode === 'collection' || mode === 'entering'));
      const focused = document.activeElement as HTMLElement | null;
      const hadFocus = !!focused && dock.contains(focused);
      // Copy-column dock (round 6): the three ways stay visible as the switcher; there is
      // no way back to the Overview (round 14), and steps/context never show.
      const copyDock = dock.classList.contains('engagement-dock--copy');
      stage.dataset.mode = mode;
      title.textContent = w && mode === 'collection' ? w.name : 'Your outcome';
      chips.forEach((b) => { b.hidden = copyDock ? false : inWay; b.setAttribute('aria-pressed', String(b.dataset.id === current)); });
      if (back) back.hidden = !inWay;
      stepsEl.hidden = copyDock || !inWay;
      if (!copyDock && inWay && w) renderSteps(w.id);
      // Where the visitor is, once a moon is chosen (no text sits on the planet).
      context.hidden = copyDock || !inWay;
      if (inWay && w) {
        const dot = document.createElement('i');
        dot.className = `dot dot-${ways.indexOf(w) + 1}`;
        dot.setAttribute('aria-hidden', 'true');
        const name = document.createElement('strong');
        name.textContent = w.name;
        const count = document.createElement('span');
        count.textContent = ` · ${w.items.length} steps`;
        context.replaceChildren(dot, name, count);
      }
      dock.setAttribute('aria-label', inWay && w ? `${w.name}: steps` : 'Ways to work together');
      if (current) renderSheet(current);
      // Keep keyboard focus in the row when the chip that had it is swapped out: Back in the
      // stage dock, otherwise the pressed chip (round 14), else the first.
      if (hadFocus && focused && (focused.hidden || !focused.isConnected || focused.offsetParent === null)) {
        const pressed = chips.find((c) => c.dataset.id === current && !c.hidden);
        (inWay && back && !back.hidden ? back : pressed ?? chips.find((c) => !c.hidden) ?? chips[0])?.focus();
      }
    }

    function select(id: CategoryId, instant = false) {
      if (!map) { current = id; render(); return; }
      if (mode === 'overview') {
        current = id; mode = 'entering'; token++;
        map.enter(id, { token, instant: reduced || instant, phase: map.getPhase() });
      } else if ((mode === 'collection' || mode === 'entering') && id !== current) {
        // Direct switch (Brandon, 2026-10-12 round 7): fly moon-to-moon at full zoom,
        // no out-and-back flight.
        if (mode === 'entering') map.completeTransition();
        current = id; mode = 'entering'; token++;
        map.switchTo(id, { token, instant: reduced });
      }
      render();
    }

    function goBack(instant = false) {
      if (!map) { if (current) { current = null; render(); } return; }
      if (mode !== 'collection' && mode !== 'entering') return;
      if (mode === 'entering') map.completeTransition();
      map.hideChildren();
      mode = 'leaving'; token++;
      map.leave({ token, instant: reduced || instant });
      render();
    }

    // The unused stage dock's Back button flies home; nothing on any page uses it today.
    back?.addEventListener('click', () => { pending = null; goBack(); }, opts);
    // A host page's reset (Work with me's browser Back to the bare URL, D1): an instant cut to
    // the Overview, never the leave flight. Escape no longer leaves a model (round 14).
    stage.addEventListener('orbit:reset', () => { pending = null; goBack(true); }, opts);
    chips.forEach((b) => b.addEventListener('click', () => select(b.dataset.id as CategoryId), opts));
    render();

    const fail = () => fallBack(stage);

    async function load() {
      if (disposed) return;
      if (!hasWebGL()) { fail(); return; }
      try {
        const { createMap } = await import('../../lib/orbit/map-scene');
        // Home close-up ("Quiet orbit", Brandon 2026-10-06): zoom in and shift the planet right.
        // Iteration 2 (Brandon 2026-10-07): the planet's right edge runs off the screen on desktop,
        // and the moons are smaller ("they don't look that realistic"). Only the close-up stage
        // passes moonScale, so Work with me keeps its moons.
        // Off production, ?zoom=&ox=&oy=&ms= override the framing so it can be tuned on the preview.
        let framing: { zoom: number; offsetX: number; offsetY: number; maxPixelRatio: number; moonScale: number; edgeFade: boolean } | undefined;
        if (stage.hasAttribute('data-closeup')) {
          framing = matchMedia('(max-width: 860px)').matches
            ? { zoom: 1.6, offsetX: 0.6, offsetY: 0, maxPixelRatio: 1.5, moonScale: 0.6, edgeFade: false }
            : { zoom: 2.1, offsetX: 0.8, offsetY: -0.1, maxPixelRatio: 1.5, moonScale: 0.6, edgeFade: false };
          if (!/(^|\.)brandonkeao\.com$/.test(location.hostname)) {
            const qs = new URLSearchParams(location.search);
            for (const [k, key] of [['zoom', 'zoom'], ['ox', 'offsetX'], ['oy', 'offsetY'], ['ms', 'moonScale']] as const) {
              const v = parseFloat(qs.get(k) ?? '');
              if (!Number.isNaN(v)) framing[key] = v;
            }
          }
        }
        if (disposed) return;
        useSet(set);
        map = createMap(host, {
          onCategoryRequest: (id) => { if (!decorative) select(id); },
          // Step moons (the retired child moons) are the only items; their meshes stay in the
          // scene hidden, so a click can still raycast them. Navigate only while they show.
          onItem: (item) => { if (host.dataset.childrenVisible === 'true') navigate(item.href); },
          onSettled(t) {
            if (t !== token || !map) return;
            // The selected view shows only the moon and its mission formation (Brandon,
            // 2026-10-12: "remove the extra moons"); the child moons stay retired.
            if (mode === 'entering') mode = 'collection';
            else if (mode === 'leaving') {
              mode = 'overview'; current = null;
              if (pending) { const p = pending; pending = null; render(); select(p); return; }
            }
            render();
          },
          onVisibility() {},
          onReady() {
            if (disposed) return;
            stage.classList.add('is-ready');
            // onReady can fire inside createMap, before `map` is assigned.
            queueMicrotask(render);
          },
          onFailure: fail,
        }, undefined, Number(stage.dataset.speed) || 1, framing);
        map.pause(paused);
        map.reduceMotion(reduced);
        // A choice made before the renderer arrived settles instantly: a refresh or deep
        // link lands on the chosen moon with no overview flash (Brandon, 2026-10-12:
        // "make the refresh and loading states feel very natural and clean").
        if (current) { const c = current; current = null; select(c, true); }
      } catch {
        fail();
      }
    }

    // Load when the stage is on screen and the browser is idle.
    const cancelLoad = whenSeen(stage, load);

    teardown = () => {
      disposed = true;
      ctl.abort();
      cancelLoad();
      map?.dispose();
      map = null;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { teardown?.(); teardown = undefined; });
</script>

<style is:global>
  .orbit-hero { display: grid; grid-template-columns: minmax(360px, 520px) minmax(0, 1fr); gap: 8px; align-items: center; padding: 8px 0 0 var(--gutter); }
  .orbit-hero--small { grid-template-columns: minmax(0, 1fr) minmax(0, 760px); padding-bottom: var(--space-hero-step); }
  /* Home: a compact copy column so the orbit takes more of the hero. */
  .orbit-hero--xl { grid-template-columns: minmax(320px, 480px) minmax(0, 1fr); }
  .orbit-hero--xl .t-display br { display: block; }
  .orbit-hero--xl .t-display { font-size: clamp(36px, 4.2vw, 56px); }
  .orbit-hero--xl .map-stage { height: 780px; }
  /* Work with me: a narrower copy column kept left, so the orbit reads as the hero's
     subject (Brandon, 2026-10-09: "make the visual a bit more prominent… the text section
     more on the left"). The camera auto-fits the stage box. The box runs the same clamp as
     the Home hero (Brandon, 2026-10-12 round 12: the Overview's layout had drifted from the
     other pages' sizing, making its transitions jarring) — and sits close to the selected
     state's height, so entering and leaving a model barely moves the layout.
     Desktop only: the phone block's plain .map-stage rule must keep winning there. */
  @media (min-width: 861px) {
    .orbit-hero--large { grid-template-columns: minmax(340px, 430px) minmax(0, 1fr); gap: 32px; }
    /* Portfolio and Playbooks (size "small") share the rule, so the three stage pages size
       their stage one way (ticket #16); Home's close-up keeps its own clamp. */
    .orbit-hero--large, .orbit-hero--small { --stage-h: clamp(540px, calc(100svh - 270px), 740px); }
    .orbit-hero--large .map-stage, .orbit-hero--small .map-stage { height: var(--stage-h); }
    /* The three copy-led stages put their h1 at one height for a given window (ticket #17, F-04):
       the copy is top-aligned where Work with me's centred copy sat (a 400px column centred in
       the stage), so a shorter column never moves the title.
       Home's close-up hero is not touched (R-01). */
    .orbit-hero--large .hero-copy, .orbit-hero--small .hero-copy { align-self: start; padding-top: calc((var(--stage-h) - 400px) / 2); }
  }
  /* Home close-up: the scene is full-bleed behind the copy; the planet sits right, cropped by the
     edge, and the canvas fades out before the copy column (like the Quiet orbit banner). */
  /* Iteration 2 (Brandon 2026-10-07): the stage is sized to the window so the Experience strip
     that follows sits on the first screen of a laptop (1440x900, 1512x982); the copy sits a
     little above centre. */
  .orbit-hero--closeup { position: relative; min-height: clamp(540px, calc(100svh - 270px), 740px); padding-top: 0; --copy-edge: calc(max(0px, (100vw - var(--content-max)) / 2) + var(--gutter) + 480px); }
  .orbit-hero--closeup .hero-copy { position: relative; z-index: 2; padding-bottom: 40px; }
  .orbit-hero--closeup .map-stage { position: absolute; z-index: 0; top: 0; bottom: 0; left: calc(50% - 50vw); width: 100vw; height: auto; }
  /* Fade out before the copy, and fade the top edge in so the scene's background meets the page ground without a seam. */
  .orbit-hero--closeup .scene-host, .orbit-hero--closeup .stage-poster img {
    -webkit-mask-image: linear-gradient(90deg, transparent calc(var(--copy-edge) - 140px), #000 calc(var(--copy-edge) + 220px)), linear-gradient(180deg, transparent 0, #000 90px, #000 calc(100% - 120px), transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent calc(var(--copy-edge) - 140px), #000 calc(var(--copy-edge) + 220px)), linear-gradient(180deg, transparent 0, #000 90px, #000 calc(100% - 120px), transparent 100%);
    mask-composite: intersect;
  }
  .orbit-hero--closeup .stage-poster img { object-position: right center; }
  .hero-rest > :first-child { margin-top: 26px; }

  .map-stage { position: relative; height: 700px; isolation: isolate; overflow: hidden; background: var(--ground); }
  .stage-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; transition: opacity 0.4s; }
  .map-stage.is-ready .stage-poster img { opacity: 0; }
  /* Collection posters (ticket #16): JPEG cannot hold the ground's exact value (it lands 1/255
     off), so the frame fades to the stage's own ground like the live scene's feather pass. */
  .map-stage[data-stage-scene] .stage-poster img {
    -webkit-mask-image: linear-gradient(90deg, transparent 10px, #000 50px, #000 calc(100% - 50px), transparent calc(100% - 10px)), linear-gradient(180deg, transparent 10px, #000 50px, #000 calc(100% - 50px), transparent calc(100% - 10px));
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 10px, #000 50px, #000 calc(100% - 50px), transparent calc(100% - 10px)), linear-gradient(180deg, transparent 10px, #000 50px, #000 calc(100% - 50px), transparent calc(100% - 10px));
    mask-composite: intersect;
  }
  .scene-host { position: absolute; inset: 0; z-index: 1; }
  .scene-host canvas { display: block; width: 100%; height: 100%; transition: opacity 0.6s ease; }
  .map-stage:not(.is-ready) .scene-host canvas { opacity: 0; }



  /* Moon labels and leaders are created by the renderer (src/lib/orbit/map-scene.ts).
     Hidden everywhere (Brandon, 2026-10-06): the chip row names the ways and steps. */
  .map-stage .scene-labels, .map-stage .label-leaders { display: none; }
  /* Decorative orbit: nothing to click. */
  .map-stage[data-static] .scene-host { pointer-events: none; }
  .scene-labels { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .scene-labels .moon-label { pointer-events: auto; }
  .label-leaders { position: absolute; inset: 0; z-index: 2; pointer-events: none; width: 100%; height: 100%; }
  .label-leaders line { stroke: #c9cbc355; stroke-width: 1; }
  .moon-label { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); padding: 9px 13px 9px 26px; background: #232521e6; border: 1px solid #ffffff1f; border-radius: var(--r-control); white-space: nowrap; text-align: left; color: var(--on-ground); font-family: var(--font); box-shadow: 0 6px 22px #0004; transition: opacity 0.15s, border-color 0.15s; }
