---
// Orbit hero: the accepted living-map renderer (src/lib/orbit) behind page copy.
// The planet is the outcome; three moons are the ways in, each with three steps.
// Server-rendered markup works without JavaScript: poster image, chips and copy.
// The renderer loads lazily once the stage is visible and the browser is idle.
//
// Slots: `headline` (the h1) and the default slot (lead, actions, proof line).
// On narrow screens the order becomes headline, orbit, then the rest.
// `still`: the stage starts paused with no Pause control; choosing a way in still flies.
// `controls`: "none" makes the orbit decorative (no chips, no Pause, moons not clickable:
// Home and Consulting, Brandon 2026-10-06); "stage" overlays the chip row on the orbit; "copy" puts it in the left
// column under the text, where it still drives the orbit (Work with me).
// `sheet`: the id of a sheet holding [data-orbit-title], [data-orbit-body] and
// [data-orbit-steps], which follows the selected way in.
import { SETS, type OrbitSet } from '../../lib/orbit/orbit-data';

interface Props { set?: OrbitSet; size?: 'closeup' | 'xl' | 'large' | 'small'; sheet?: string; still?: boolean; controls?: 'none' | 'stage' | 'copy'; speed?: number }
const { set = 'home', size = 'large', sheet, still = false, controls = 'stage', speed = 1 } = Astro.props;
const ways = SETS[set];
const closeup = size === 'closeup';
const poster = closeup
  ? { desktop: '/images/orbit/home-closeup-desktop.jpg', mobile: '/images/orbit/home-closeup-mobile.jpg' }
  : set === 'home'
    ? { desktop: '/images/orbit/home-desktop.jpg', mobile: '/images/orbit/home-mobile.jpg' }
    : { desktop: '/images/orbit/work-desktop.jpg', mobile: '/images/orbit/work-mobile.jpg' };
---

<section class:list={['orbit-hero', `orbit-hero--${size}`, closeup && 'orbit-hero--xl']}>
  <div class="hero-copy">
    <div class="hero-headline"><slot name="headline" /></div>
    <div class="hero-rest">
      <slot />
      <!-- The one control row (Brandon, 2026-10-06): ways in, or Back and the chosen way's steps; Pause sits here too. -->
      {controls === 'copy' && (
        <div class="engagement-dock engagement-dock--copy" role="group" aria-label="Ways to work together" data-dock>
          <p class="dock-context" data-context hidden></p>
          <button class="engagement-chip" type="button" data-back hidden>← Back</button>
          {ways.map((w, i) => (
            <button class="engagement-chip" type="button" data-id={w.id} aria-pressed="false">
              <i class={`dot dot-${i + 1}`} aria-hidden="true"></i>{w.name}
            </button>
          ))}
          <span class="dock-steps" data-steps hidden></span>
          <button class="engagement-chip dock-pause" type="button" data-pause aria-pressed="false" hidden><i aria-hidden="true"></i><span>Pause motion</span></button>
        </div>
      )}
    </div>
  </div>
  <div class="map-stage" data-orbit={set} data-sheet={sheet} data-still={still ? '' : undefined} data-static={controls === 'none' ? '' : undefined} data-speed={speed} data-closeup={closeup ? '' : undefined} data-mode="overview">
    <picture class="stage-poster">
      <source media="(max-width: 860px)" srcset={poster.mobile} />
      <img src={poster.desktop} alt="" width="840" height="700" decoding="async" fetchpriority={size === 'small' ? 'auto' : 'high'} />
    </picture>
    <div class="scene-host"></div>
    <!-- No visible text over the planet (Brandon, 2026-10-06); the title stays for screen readers. -->
    <div class="sr-only" aria-live="polite">
      <h2 id="map-current-title" tabindex="-1" data-title>Your outcome</h2>
    </div>
    <!-- The one control row (Brandon, 2026-10-06): ways in, or Back and the chosen way's steps; Pause sits here too. -->
    {(controls === 'stage' || controls === 'none') && (
    <div class="engagement-dock" role="group" aria-label="Ways to work together" data-dock hidden={controls === 'none'}>
      <p class="dock-context" data-context hidden></p>
      <button class="engagement-chip" type="button" data-back hidden>← Back</button>
      {ways.map((w, i) => (
        <button class="engagement-chip" type="button" data-id={w.id} aria-pressed="false">
          <i class={`dot dot-${i + 1}`} aria-hidden="true"></i>{w.name}
        </button>
      ))}
      <span class="dock-steps" data-steps hidden></span>
      <button class="engagement-chip dock-pause" type="button" data-pause aria-pressed="false" hidden><i aria-hidden="true"></i><span>Pause motion</span></button>
    </div>
    )}
  </div>
</section>

<script>
  import { SETS, useSet, type CategoryId, type OrbitSet } from '../../lib/orbit/orbit-data';
  import type { MapController } from '../../lib/orbit/map-scene';
  import { navigate } from 'astro:transitions/client';

  type Mode = 'overview' | 'entering' | 'collection' | 'leaving';
  let teardown: (() => void) | undefined;

  function init() {
    teardown?.();
    teardown = undefined;
    const stage = document.querySelector<HTMLElement>('.map-stage[data-orbit]');
    if (!stage) return;

    const set = (stage.dataset.orbit as OrbitSet) || 'home';
    const ways = SETS[set];
    const hero = stage.closest('.orbit-hero') ?? stage;
    const q = <T extends HTMLElement>(s: string, root: ParentNode = hero) => root.querySelector<T>(s)!;
    const host = q('.scene-host');
    const title = q('[data-title]');
    const dock = q('[data-dock]');
    const back = q<HTMLButtonElement>('[data-back]');
    const pauseBtn = q<HTMLButtonElement>('[data-pause]');
    const stepsEl = q('[data-steps]');
    const context = q('[data-context]');
    const chips = [...hero.querySelectorAll<HTMLButtonElement>('.engagement-chip[data-id]')];
    let stepsFor: CategoryId | null = null;
    const sheet = stage.dataset.sheet ? document.getElementById(stage.dataset.sheet) : null;

    const ctl = new AbortController();
    const opts = { signal: ctl.signal };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let mode: Mode = 'overview';
    let current: CategoryId | null = null;
    let pending: CategoryId | null = null;
    let token = 0;
    const still = stage.hasAttribute('data-still');
    const decorative = stage.hasAttribute('data-static');
    let paused = reduced || still;
    let map: MapController | null = null;
    let disposed = false;

    function renderSheet(id: CategoryId) {
      if (!sheet) return;
      const w = ways.find((x) => x.id === id)!;
      const t = sheet.querySelector('[data-orbit-title]');
      const b = sheet.querySelector('[data-orbit-body]');
      const list = sheet.querySelector('[data-orbit-steps]');
      if (t) t.textContent = w.name;
      if (b) b.textContent = w.summary;
      list?.replaceChildren(...w.items.map((it, i) => {
        const li = document.createElement('li');
        const n = document.createElement('span');
        n.textContent = String(i + 1).padStart(2, '0');
        const s = document.createElement('strong');
        const a = document.createElement('a');
        a.href = it.href;
        a.textContent = it.title;
        s.append(a);
        const p = document.createElement('p');
        p.textContent = it.description;
        li.append(n, s, p);
        return li;
      }));
    }

    // The chosen way's steps as chips; each opens the step's page, like its moon label.
    function renderSteps(id: CategoryId) {
      if (stepsFor === id) return;
      stepsFor = id;
      const i = ways.findIndex((x) => x.id === id);
      stepsEl.replaceChildren(...ways[i].items.map((it) => {
        const a = document.createElement('a');
        a.className = 'engagement-chip';
        a.href = it.href;
        const dot = document.createElement('i');
        dot.className = `dot dot-${i + 1}`;
        dot.setAttribute('aria-hidden', 'true');
        a.append(dot, it.title);
        return a;
      }));
    }

    function render() {
      const w = ways.find((x) => x.id === current);
      const inWay = !!(w && map && (mode === 'collection' || mode === 'entering'));
      const focused = document.activeElement as HTMLElement | null;
      const hadFocus = !!focused && dock.contains(focused);
      stage.dataset.mode = mode;
      title.textContent = w && mode === 'collection' ? w.name : 'Your outcome';
      chips.forEach((b) => { b.hidden = inWay; b.setAttribute('aria-pressed', String(b.dataset.id === current)); });
      back.hidden = !inWay;
      stepsEl.hidden = !inWay;
      if (inWay && w) renderSteps(w.id);
      // Where the visitor is, once a moon is chosen (no text sits on the planet).
      context.hidden = !inWay;
      if (inWay && w) {
        const dot = document.createElement('i');
        dot.className = `dot dot-${ways.indexOf(w) + 1}`;
        dot.setAttribute('aria-hidden', 'true');
        const name = document.createElement('strong');
        name.textContent = w.name;
        const count = document.createElement('span');
        count.textContent = ` · ${w.items.length} steps`;
        context.replaceChildren(dot, name, count);
      }
      dock.setAttribute('aria-label', inWay && w ? `${w.name}: steps` : 'Ways to work together');
      pauseBtn.hidden = !map || still || !stage.classList.contains('is-ready');
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.querySelector('span')!.textContent = paused ? 'Resume motion' : 'Pause motion';
      if (current) renderSheet(current);
      // Keep keyboard focus in the row when the chip that had it is swapped out.
      if (hadFocus && focused && (focused.hidden || !focused.isConnected || focused.offsetParent === null)) (inWay ? back : chips.find((c) => c.dataset.id === stepsFor) ?? chips[0]).focus();
    }

    function select(id: CategoryId) {
      if (!map) { current = id; render(); return; }
      if (mode === 'overview') {
        current = id; mode = 'entering'; token++;
        map.enter(id, { token, instant: reduced, phase: map.getPhase() });
      } else if (mode === 'collection' && id !== current) {
        pending = id; goBack();
      }
      render();
    }

    function goBack() {
      if (!map || (mode !== 'collection' && mode !== 'entering')) return;
      if (mode === 'entering') map.completeTransition();
      map.hideChildren();
      mode = 'leaving'; token++;
      map.leave({ token, instant: reduced });
      render();
    }

    back.addEventListener('click', () => { pending = null; goBack(); }, opts);
    document.addEventListener('keydown', (e) => {
      if (!decorative && e.key === 'Escape' && (mode === 'collection' || mode === 'entering')) { pending = null; goBack(); }
    }, opts);
    pauseBtn.addEventListener('click', () => { paused = !paused; map?.pause(paused); render(); }, opts);
    chips.forEach((b) => b.addEventListener('click', () => select(b.dataset.id as CategoryId), opts));
    render();

    const fail = () => { stage.classList.add('is-fallback'); stage.classList.remove('is-ready'); };

    async function load() {
      if (disposed) return;
      const probe = document.createElement('canvas');
      if (!(probe.getContext('webgl2') || probe.getContext('webgl'))) { fail(); return; }
      try {
        const { createMap } = await import('../../lib/orbit/map-scene');
        // Home close-up ("Quiet orbit", Brandon 2026-10-06): zoom in and shift the planet right.
        // Iteration 2 (Brandon 2026-10-07): the planet's right edge runs off the screen on desktop,
        // and the moons are smaller ("they don't look that realistic"). Only the close-up stage
        // passes moonScale, so Work with me keeps its moons.
        // Off production, ?zoom=&ox=&oy=&ms= override the framing so it can be tuned on the preview.
        let framing: { zoom: number; offsetX: number; offsetY: number; maxPixelRatio: number; moonScale: number } | undefined;
        if (stage.hasAttribute('data-closeup')) {
          framing = matchMedia('(max-width: 860px)').matches
            ? { zoom: 1.6, offsetX: 0.6, offsetY: 0, maxPixelRatio: 1.5, moonScale: 0.6 }
            : { zoom: 2.1, offsetX: 0.8, offsetY: -0.1, maxPixelRatio: 1.5, moonScale: 0.6 };
          if (!/(^|\.)brandonkeao\.com$/.test(location.hostname)) {
            const qs = new URLSearchParams(location.search);
            for (const [k, key] of [['zoom', 'zoom'], ['ox', 'offsetX'], ['oy', 'offsetY'], ['ms', 'moonScale']] as const) {
              const v = parseFloat(qs.get(k) ?? '');
              if (!Number.isNaN(v)) framing[key] = v;
            }
          }
        }
        if (disposed) return;
        useSet(set);
        map = createMap(host, {
          onCategoryRequest: (id) => { if (!decorative) select(id); },
          onItem: (item) => navigate(item.href),
          onSettled(t) {
            if (t !== token || !map) return;
            if (mode === 'entering') { mode = 'collection'; map.showChildren(); }
            else if (mode === 'leaving') {
              mode = 'overview'; current = null;
              if (pending) { const p = pending; pending = null; render(); select(p); return; }
            }
            render();
          },
          onVisibility() {},
          onReady() {
            if (disposed) return;
            stage.classList.add('is-ready');
            // onReady can fire inside createMap, before `map` is assigned.
            queueMicrotask(render);
          },
          onFailure: fail,
        }, undefined, Number(stage.dataset.speed) || 1, framing);
        map.pause(paused);
        map.reduceMotion(reduced);
        // A choice made before the renderer arrived flies in now.
        if (current) { const c = current; current = null; select(c); }
      } catch {
        fail();
      }
    }

    // Load when the stage is on screen and the browser is idle.
    const idle = (fn: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 200);
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { seen.disconnect(); idle(load); }
    });
    seen.observe(stage);

    teardown = () => {
      disposed = true;
      ctl.abort();
      seen.disconnect();
      map?.dispose();
      map = null;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { teardown?.(); teardown = undefined; });
</script>

<style is:global>
  .orbit-hero { display: grid; grid-template-columns: minmax(360px, 520px) minmax(0, 1fr); gap: 8px; align-items: center; padding: 8px 0 0 var(--gutter); }
  .orbit-hero--small { grid-template-columns: minmax(0, 1fr) minmax(0, 760px); padding-bottom: 24px; }
  /* Home: a compact copy column so the orbit takes more of the hero. */
  .orbit-hero--xl { grid-template-columns: minmax(320px, 480px) minmax(0, 1fr); }
  .orbit-hero--xl .t-display br { display: block; }
  .orbit-hero--xl .t-display { font-size: clamp(36px, 4.2vw, 56px); }
  .orbit-hero--xl .map-stage { height: 780px; }
  /* Home close-up: the scene is full-bleed behind the copy; the planet sits right, cropped by the
     edge, and the canvas fades out before the copy column (like the Quiet orbit banner). */
  /* Iteration 2 (Brandon 2026-10-07): the stage is sized to the window so the Experience strip
     that follows sits on the first screen of a laptop (1440x900, 1512x982); the copy sits a
     little above centre. */
  .orbit-hero--closeup { position: relative; min-height: clamp(540px, calc(100svh - 270px), 740px); padding-top: 0; --copy-edge: calc(max(0px, (100vw - var(--content-max)) / 2) + var(--gutter) + 480px); }
  .orbit-hero--closeup .hero-copy { position: relative; z-index: 2; padding-bottom: 40px; }
  .orbit-hero--closeup .map-stage { position: absolute; z-index: 0; top: 0; bottom: 0; left: calc(50% - 50vw); width: 100vw; height: auto; }
  /* Fade out before the copy, and fade the top edge in so the scene's background meets the page ground without a seam. */
  .orbit-hero--closeup .scene-host, .orbit-hero--closeup .stage-poster img {
    -webkit-mask-image: linear-gradient(90deg, transparent calc(var(--copy-edge) - 140px), #000 calc(var(--copy-edge) + 220px)), linear-gradient(180deg, transparent 0, #000 90px, #000 calc(100% - 120px), transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent calc(var(--copy-edge) - 140px), #000 calc(var(--copy-edge) + 220px)), linear-gradient(180deg, transparent 0, #000 90px, #000 calc(100% - 120px), transparent 100%);
    mask-composite: intersect;
  }
  .orbit-hero--closeup .stage-poster img { object-position: right center; }
  .hero-rest > :first-child { margin-top: 26px; }

  .map-stage { position: relative; height: 700px; isolation: isolate; overflow: hidden; background: var(--ground); }
  .orbit-hero--small .map-stage { height: 520px; }
  .stage-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; transition: opacity 0.4s; }
  .map-stage.is-ready .stage-poster img { opacity: 0; }
  .scene-host { position: absolute; inset: 0; z-index: 1; }
  .scene-host canvas { display: block; width: 100%; height: 100%; }
  .map-stage:not(.is-ready) .scene-host canvas { opacity: 0; }

  [data-pause] i { width: 8px; height: 10px; border-left: 2.5px solid currentColor; border-right: 2.5px solid currentColor; }
  [data-pause][aria-pressed='true'] i { width: 0; height: 0; border: 0; border-left: 9px solid currentColor; border-top: 5.5px solid transparent; border-bottom: 5.5px solid transparent; }


  /* Moon labels and leaders are created by the renderer (src/lib/orbit/map-scene.ts).
     Hidden everywhere (Brandon, 2026-10-06): the chip row names the ways and steps. */
  .map-stage .scene-labels, .map-stage .label-leaders { display: none; }
  /* Decorative orbit: nothing to click. */
  .map-stage[data-static] .scene-host { pointer-events: none; }
  .scene-labels { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .scene-labels .moon-label { pointer-events: auto; }
  .label-leaders { position: absolute; inset: 0; z-index: 2; pointer-events: none; width: 100%; height: 100%; }
  .label-leaders line { stroke: #c9cbc355; stroke-width: 1; }
  .moon-label { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); padding: 9px 13px 9px 26px; background: #232521e6; border: 1px solid #ffffff1f; border-radius: var(--r-control); white-space: nowrap; text-align: left; color: var(--on-ground); font-family: var(--font); box-shadow: 0 6px 22px #0004; transition: opacity 0.15s, border-color 0.15s; }
  .moon-label::before { content: ''; position: absolute; left: 12px; top: 15px; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-on-ground); }
  .moon-label strong { display: block; font-size: 13px; font-weight: 600; }
  .moon-label span { display: block; font-size: 11px; color: var(--on-ground-faint); margin-top: 2px; }
  .moon-label:hover { border-color: #f16b6599; background: #2f322d; }
  .moon-label.is-compact span { display: none; }

  .engagement-dock { position: absolute; z-index: 4; left: 24px; right: var(--gutter); bottom: 18px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .engagement-chip { display: inline-flex; align-items: center; gap: 9px; padding: 10px 14px; border-radius: var(--r-pill); border: 1px solid var(--control-line-on-ground); background: #2b2d29d9; font-size: 14px; color: var(--on-ground-muted); }
  .engagement-chip:hover { color: var(--on-ground); }
  .engagement-chip[aria-pressed='true'] { color: var(--on-ground); border-color: var(--accent-on-ground); }
  .dock-steps { display: contents; }
  .dock-context { flex-basis: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 4px; font-size: 15px; color: var(--on-ground-faint); }
  .dock-context strong { color: var(--on-ground); font-weight: 600; }
  .dock-pause { gap: 8px; }
  /* Controls in the copy column: a left-aligned row under the text, not over the orbit. */
  .engagement-dock--copy { position: static; justify-content: flex-start; margin-top: 32px; padding: 0; }
  .engagement-dock--copy .dock-context { justify-content: flex-start; }

  @media (max-width: 860px) {
    .orbit-hero, .orbit-hero--small, .orbit-hero--xl { grid-template-columns: minmax(0, 1fr); padding: 8px 0 0; }
    .hero-copy { display: contents; }
    .hero-headline { order: 1; padding: 8px var(--gutter) 0; }
    /* On phones the scene keeps its own 400px and the control row sits below it, so chips never cover a moon. */
    .map-stage, .orbit-hero--small .map-stage, .orbit-hero--xl .map-stage { order: 2; height: auto; margin-top: 4px; }
    .scene-host { position: relative; inset: auto; height: 400px; }
    .stage-poster img { bottom: auto; height: 400px; }
    .hero-rest { order: 3; padding: 0 var(--gutter) 32px; }
    .hero-rest > :first-child { margin-top: 8px; }
    .engagement-dock { position: relative; left: auto; right: auto; bottom: auto; padding: 8px 12px 4px; }
    .engagement-dock--copy { padding: 0; margin-top: 24px; }
    .scene-labels, .label-leaders { display: none; }
    .engagement-chip { font-size: 13px; padding: 8px 12px; }
    .hero-proof { display: none; }
  }
  @media (max-width: 860px) {
    /* Phones: the big planet bleeds off the right behind the headline; lead and CTAs below on plain ground. */
    /* overflow-x: clip keeps the meteor's flight from making the page scroll sideways. */
    .orbit-hero--closeup { display: block; min-height: 0; padding: 0; overflow-x: clip; }
    .orbit-hero--closeup .hero-copy { display: block; padding-bottom: 0; }
    .orbit-hero--closeup .hero-headline { padding: 8px var(--gutter) 0; min-height: 360px; }
    .orbit-hero--closeup .hero-rest { padding: 0 var(--gutter) 32px; }
    /* Home v2 review (AD-10, AD-11): the stage starts 48px lower and the mask keeps a quiet zone
       under the headline and the lead, so no line crosses the copy and the far moon stays hidden. */
    .orbit-hero--closeup .map-stage { position: absolute; top: 48px; bottom: auto; height: 400px; margin: 0; }
    .orbit-hero--closeup .scene-host { position: absolute; inset: 0; height: 400px; }
    .orbit-hero--closeup .stage-poster img { height: 400px; }
    .orbit-hero--closeup .scene-host, .orbit-hero--closeup .stage-poster img {
      -webkit-mask-image: radial-gradient(120% 90% at 100% 58%, #000 30%, transparent 70%), linear-gradient(180deg, #000 60%, transparent 80%);
      -webkit-mask-composite: source-in;
      mask-image: radial-gradient(120% 90% at 100% 58%, #000 30%, transparent 70%), linear-gradient(180deg, #000 60%, transparent 80%);
      mask-composite: intersect;
    }
  }
  /* Short landscape phones (AD-12): the 768 composition in one screen. Copy stays left, the planet
     sits right in a 300px stage, and the lead and actions follow the headline directly. */
  @media (max-width: 1023px) and (max-height: 500px) {
    .orbit-hero--closeup { display: block; min-height: 0; padding: 0; overflow-x: clip; }
    .orbit-hero--closeup .hero-copy { display: block; max-width: calc(var(--gutter) + 400px); padding-bottom: 0; }
    .orbit-hero--closeup .hero-headline { padding: 8px var(--gutter) 0; min-height: 0; }
    .orbit-hero--closeup .hero-rest { padding: 0 0 32px var(--gutter); }
    .orbit-hero--closeup .hero-rest > :first-child { margin-top: 16px; }
    .orbit-hero--closeup .map-stage { position: absolute; top: 0; bottom: auto; left: calc(50% - 50vw); width: 100vw; height: 300px; margin: 0; }
    .orbit-hero--closeup .scene-host { position: absolute; inset: 0; height: 300px; }
    .orbit-hero--closeup .stage-poster img { height: 300px; }
    .orbit-hero--closeup .scene-host, .orbit-hero--closeup .stage-poster img {
      -webkit-mask-image: radial-gradient(70% 120% at 100% 50%, #000 30%, transparent 70%);
      -webkit-mask-composite: source-over;
      mask-image: radial-gradient(70% 120% at 100% 50%, #000 30%, transparent 70%);
      mask-composite: add;
    }
  }
</style>
