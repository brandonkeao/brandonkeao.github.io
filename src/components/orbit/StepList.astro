---
// Numbered steps. A step with an href links its title.
interface Props { steps: { title: string; description: string; href?: string }[]; [key: string]: unknown }
const { steps, ...rest } = Astro.props;
---

<ol class="steps" {...rest}>
  {steps.map((s, i) => (
    <li>
      <span>{String(i + 1).padStart(2, '0')}</span>
      <strong>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</strong>
      <p>{s.description}</p>
    </li>
  ))}
</ol>
