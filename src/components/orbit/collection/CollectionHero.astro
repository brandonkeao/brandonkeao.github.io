---
// Collection hero on the system's own stage (Brandon, 2026-10-12 round 8: Portfolio and
// Playbooks "don't look like part of the rest of the system" — bring in the animation
// pattern About and Work with me carry). The page title gets the red align line, and the
// live orbital scene rides beside the copy as a decorative stage: no chips, no selection,
// and — per round 5 — no formations on a static stage. The old static trace strip retires.
import OrbitStage from '../OrbitStage.astro';
import MotionLine from '../MotionLine.astro';
import './collection.css';

interface Props { title: string; lead: string; body: string; note: string }
const { title, lead, body, note } = Astro.props;
---

<OrbitStage set="home" size="small" controls="none" speed={2}>
  <div slot="headline" style="width:fit-content;max-width:100%">
    <h1 id="cl-hero-title" class="t-page-title">{title}</h1>
    <MotionLine kind="align" stretch />
  </div>
  <p class="t-lead cl-hero-lead">{lead}</p>
  <p class="t-body muted-g cl-hero-body">{body}</p>
  <p class="t-small faint-g cl-hero-note">{note}</p>
</OrbitStage>
