---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sheet from '../components/orbit/Sheet.astro';
import Clause from '../components/orbit/Clause.astro';
import Closing from '../components/orbit/Closing.astro';
import TextLink from '../components/orbit/TextLink.astro';

const about = [
  {
    title: 'Startups to enterprise',
    lead: "I've seen early-stage startups figuring out what to build, scaling companies improving what they built, and enterprises working through years of accumulated complexity.",
    body: [
      'That work has included user research, product strategy, design systems, and team development.',
      'I care about things that actually work: useful tools that solve problems for the people using them.',
    ],
  },
  {
    title: 'Systems thinking',
    lead: 'Building useful things means understanding how information flows, how decisions get made, and how teams coordinate.',
    body: [
      'Product work is systems design. I tend to reduce complex things into flowcharts. If I cannot map the problem, I probably do not understand it yet.',
      'That habit started with my engineering degree at Northwestern University and has carried through consulting, product, design, research, strategy, and leadership roles.',
    ],
  },
  {
    title: "What I'm building now",
    lead: 'Right now I work across product, growth, data, engineering, operations, and AI.',
    body: [
      'I am building tools that help people use AI in their day-to-day work: keeping useful information at hand, recording decisions, and checking the results. I want those tools to make the work easier to pick up and continue.',
      'The work is familiar: understand the customer, find what is getting in the way, build something useful, and learn from what happens next.',
    ],
  },
  {
    title: 'How I try to work',
    lead: 'I build instead of speculating, start simple, and use evidence. I give people room to lead and keep fixing small things.',
    body: [
      'I value transparency, trust, respect, and ownership. I try to state what I know, what I do not know, and what I think we should do next. I move fast, sometimes too fast, so I am continually working on sharing context and bringing people along.',
      'The longer version is my Manager README. It covers one-on-ones, feedback, development, ownership, and how I try to serve the team.',
    ],
  },
];
import MotionLine from '../components/orbit/MotionLine.astro';
---

<BaseLayout title="About" description="Brandon Keao is a product leader and builder with 18+ years in technology across consulting, product, design, research, and strategy.">
  <header class="page-header about-head">
    <img class="portrait" src="/images/brandon-keao-headshot.jpg" alt="Brandon Keao" width="260" height="260" />
    <div>
      <h1 class="t-page-title">Product leader and builder</h1>
      <MotionLine kind="map" />
      <p class="t-lead muted-g" style="margin-top:20px;max-width:640px">I've spent 18+ years building products, leading teams, and designing systems in complex organizations.</p>
    </div>
  </header>

  <Sheet label="About">
    <div class="divider-list">
      {about.map((a) => (
        <Clause title={a.title} as="h2">
          <p class="t-lead">{a.lead}</p>
          {a.body.map((b) => <p class="t-body muted-s" style="margin-top:12px">{b}</p>)}
        </Clause>
      ))}
    </div>
    <p class="about-link"><TextLink href="/manager-readme">Read my Manager README</TextLink></p>
  </Sheet>

  <Closing title="If the work needs a builder, let's talk." />
</BaseLayout>

<style>
  .about-head { display: flex; gap: 56px; align-items: center; }
  .about-head .portrait { width: 260px; height: 260px; flex: none; }
  .about-link { margin-top: 24px; padding-left: 320px; }
  @media (max-width: 860px) {
    .about-head { display: block; }
    .about-head .portrait { width: 120px; height: 120px; margin-bottom: 20px; }
    .about-link { padding-left: 0; }
  }
</style>
