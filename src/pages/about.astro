---
// About (ticket #39, designer review Phase 1): the shared PageHero with the `principles` mark (#45, was `map`) run out as
// the content-width red line and the portrait kept beside the title (Brandon, 2026-10-13: "Keep
// my profile image"); How I work leaves the dark band for the top of the first white sheet, in
// the readable section pattern from Work with me (on the About sections' heading/reading grid, one
// reading column in the sheet's ink, no 01-04 numbers). Copy verbatim; layout choices are AI-made and reversible.
import BaseLayout from '../layouts/BaseLayout.astro';
import Sheet from '../components/orbit/Sheet.astro';
import Clause from '../components/orbit/Clause.astro';
import Closing from '../components/orbit/Closing.astro';
import TextLink from '../components/orbit/TextLink.astro';
import SectionHead from '../components/orbit/SectionHead.astro';
import PageHero from '../components/orbit/PageHero.astro';

const about = [
  {
    title: 'Startups to enterprise',
    lead: "I've seen early-stage startups figuring out what to build, scaling companies improving what they built, and enterprises working through years of accumulated complexity.",
    body: [
      'That work has included user research, product strategy, design systems, and team development.',
      'I care about things that actually work: useful tools that solve problems for the people using them.',
    ],
  },
  {
    title: 'Systems thinking',
    lead: 'Building useful things means understanding how information flows, how decisions get made, and how teams coordinate.',
    body: [
      'Product work is systems design. I tend to reduce complex things into flowcharts. If I cannot map the problem, I probably do not understand it yet.',
      'That habit started with my engineering degree at Northwestern University and has carried through consulting, product, design, research, strategy, and leadership roles.',
    ],
  },
  {
    title: "What I'm building now",
    lead: 'Right now I work across product, growth, data, engineering, operations, and AI.',
    body: [
      'I am building tools that help people use AI in their day-to-day work: keeping useful information at hand, recording decisions, and checking the results. I want those tools to make the work easier to pick up and continue.',
      'The work is familiar: understand the customer, find what is getting in the way, build something useful, and learn from what happens next.',
    ],
  },
  {
    title: 'How I try to work',
    lead: 'I build instead of speculating, start simple, and use evidence. I give people room to lead and keep fixing small things.',
    body: [
      'I value transparency, trust, respect, and ownership. I try to state what I know, what I do not know, and what I think we should do next. I move fast, sometimes too fast, so I am continually working on sharing context and bringing people along.',
      'The longer version is my Manager README. It covers one-on-ones, feedback, development, ownership, and how I try to serve the team.',
    ],
  },
];
const principles = [
  { title: 'Understand', body: 'Start with customer and market needs. Map the system and make the problem clear enough to act on.' },
  { title: 'Start', body: 'Starting is the best way to begin learning and make progress. Use judgment, but do not let endless debate become the work.' },
  { title: 'Own', body: 'Leadership comes from everywhere. Own the problems in your world and make it easier for other people to lead.' },
  { title: 'Improve', body: 'Give honest, timely feedback and keep fixing small things. The small fixes add up.' },
];
---

<BaseLayout title="About" description="Brandon Keao is a product leader and builder with 18+ years in technology across consulting, product, design, research, and strategy.">
  <PageHero title="Product leader and builder" mark="principles" lead="I've spent 18+ years building products, leading teams, and designing systems in complex organizations." class="about-hero">
    <img slot="aside" class="portrait about-portrait" src="/images/brandon-keao-headshot.jpg" alt="Brandon Keao" width="260" height="260" />
  </PageHero>

  <Sheet label="About" class="about-sheet">
    <section class="about-band about-process" aria-labelledby="about-process">
      <div class="about-band-head">
        <SectionHead id="about-process" eyebrow="How I work" title="The minimum process needed to be effective." />
      </div>
      <ul class="about-band-body about-steps">
        {principles.map((p) => (
          <li>
            <h3 class="about-step-title">{p.title}</h3>
            <p class="about-read">{p.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <div class="divider-list about-clauses">
      {about.map((a) => (
        <Clause title={a.title} as="h2">
          <p class="t-lead">{a.lead}</p>
          {a.body.map((b) => <p class="t-body muted-s" style="margin-top:12px">{b}</p>)}
        </Clause>
      ))}
    </div>
    <p class="about-link"><TextLink href="/manager-readme/">Read my Manager README</TextLink></p>
  </Sheet>

  <Closing title="If the work needs a builder, let's talk." />
</BaseLayout>

<style is:global>
  /* The portrait beside the title and lead, top-aligned with the title (PageHero's aside); about
     the height of the title and lead, so the hero stays near Bookshelf's. On phones it is the
     title's height (three lines), which keeps the font swap from shifting the page. */
  .about-portrait { width: 160px; height: 160px; }

  /* How I work: the first section of the white sheet, on the About sections' own grid below it
     (the .clause grid: a 280px heading column, the reading column from 320px), so every body
     text in the sheet shares one left edge. Readable pattern from Work with me: one reading
     column (about 630px, 18px, the sheet's ink), a hairline between principles, no numbers.
     The h2 is sized to sit in the heading column. */
  .about-band { display: grid; grid-template-columns: 280px minmax(0, 1fr); column-gap: 40px; padding-bottom: 56px; }
  .about-band-head .section-head { max-width: none; }
  @media (min-width: 861px) { .about-band-head .t-section { font-size: 28px; line-height: 1.2; } }
  .about-band-body { min-width: 0; }
  .about-steps { list-style: none; margin: 0; padding: 0; max-width: 630px; }
  .about-steps li { padding: 20px 0; border-top: 1px solid var(--line-on-sheet); }
  .about-steps li:first-child { border-top: 0; padding-top: 0; }
  .about-steps li:last-child { padding-bottom: 0; }
  .about-step-title { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; color: var(--on-sheet); }
  .about-read { margin-top: 6px; font-size: 18px; line-height: 1.6; color: var(--on-sheet); }

  .about-link { margin-top: 24px; padding-left: 320px; }
  @media (max-width: 860px) {
    .about-portrait { width: 112px; height: 112px; }
    .about-band { grid-template-columns: minmax(0, 1fr); row-gap: 20px; padding-bottom: 40px; }
    .about-steps li { padding: 16px 0; }
    .about-read { font-size: 17px; }
    .about-step-title { font-size: 19px; }
    .about-link { padding-left: 0; }
  }
</style>
