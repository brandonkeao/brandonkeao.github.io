---
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceAreas = [
  {
    title: 'Product Vision, Strategy & Positioning',
    items: ['Vision development', 'Strategic planning', 'Positioning', 'Roadmapping', 'Go-to-market strategy', 'Strategy summits']
  },
  {
    title: 'Product Design & User Research',
    items: ['User personas', 'Experience research', 'Customer journeys', 'Interviews', 'Usability testing', 'Opportunity mapping']
  },
  {
    title: 'Product Operations & Organization Design',
    items: ['Organizational assessments', 'Team structure', 'Competency frameworks', 'Analytics reviews', 'Decision practices', 'Operating cadence']
  },
  {
    title: 'Coaching & Mentoring',
    items: ['Product coaching', 'Team hiring', 'Communication', 'Prioritization', 'Functional training', 'Leadership development']
  }
];
---

<BaseLayout title="Work With Me" description="Product strategy, discovery, assessment, and fractional product leadership with Brandon Keao.">
  <section class="page-hero">
    <div class="container">
      <p class="kicker">Work with me</p>
      <h1 class="page-title">Get unstuck.<br />Build momentum.</h1>
      <p class="page-dek">I help leaders clarify product direction, understand customer and market needs, strengthen the team around the work, and stay close enough to execution to make the change real.</p>
    </div>
  </section>

  <section class="v2-section">
    <div class="container">
      <div class="v2-section-heading">
        <p class="kicker">How we begin</p>
        <h2 class="v2-section-title">Start with the amount of help the problem needs.</h2>
      </div>

      <div class="v2-engagements">
        <article class="v2-engagement">
          <span class="v2-number">01</span>
          <div>
            <span class="v2-engagement-meta">Free · 30 minutes</span>
            <h3>Phone consultation</h3>
          </div>
          <p>Tell me what you are trying to accomplish and where you are stuck. I will give you an honest view of whether I can help and what a useful next step could be.</p>
          <span class="v2-engagement-symbol" aria-hidden="true">◎</span>
        </article>

        <article class="v2-engagement">
          <span class="v2-number">02</span>
          <div>
            <span class="v2-engagement-meta">Up to 20 hours · Two weeks</span>
            <h3>Discovery and assessment</h3>
          </div>
          <p>A focused diagnostic when the team knows something needs to change but has not yet aligned on the cause, the options, or the next move.</p>
          <span class="v2-engagement-symbol" aria-hidden="true">↗</span>
        </article>

        <article class="v2-engagement">
          <span class="v2-number">03</span>
          <div>
            <span class="v2-engagement-meta">Ongoing · Scope to fit</span>
            <h3>Fractional Head of Product</h3>
          </div>
          <p>Hands-on product leadership to define the vision, drive strategy, guide development, improve product-market fit, and help the team build the capacity to keep going.</p>
          <span class="v2-engagement-symbol" aria-hidden="true">∞</span>
        </article>
      </div>

      <p class="meta max-w-2xl">The engagement names and original scope come from the pre-Astro site. Current pricing, availability, and exact commitments are intentionally held for Brandon's review.</p>
    </div>
  </section>

  <section class="v2-section v2-dark">
    <div class="container">
      <div class="v2-split-heading">
        <div>
          <p class="kicker">Where I can help</p>
          <h2 class="v2-section-title">The product is only one part of the system.</h2>
        </div>
        <p class="v2-lead">Important outcomes often cross Product, Design, Research, Engineering, Growth, Data, Marketing, and Operations. I work across those boundaries without losing the customer problem at the center.</p>
      </div>

      <div class="service-area-grid">
        {serviceAreas.map((area, index) => (
          <article class="service-area">
            <span>0{index + 1}</span>
            <h3>{area.title}</h3>
            <ul>
              {area.items.map(item => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v2-section">
    <div class="container v2-about-grid">
      <div>
        <p class="kicker">What working together feels like</p>
        <h2 class="v2-section-title">Clear expectations. Honest feedback. Shared ownership.</h2>
      </div>
      <div>
        <p class="v2-lead">I believe leadership comes from everywhere. My role is to help make the problem clear, create the conditions for good work, and support the people doing it.</p>
        <p class="service-body">The full version includes how I run one-on-ones, give feedback, think about development, and hold myself accountable when my behavior does not match the values on the page.</p>
        <a class="text-link" href="/manager-readme">Read my Manager README <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="v2-section v2-contact">
    <div class="container">
      <p class="kicker">Start a conversation</p>
      <h2>Tell me what you're trying to move.</h2>
      <a class="btn btn-primary" href="/contact">Get in touch <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
