---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrbitStage from '../components/orbit/OrbitStage.astro';
import Sheet from '../components/orbit/Sheet.astro';
import WayRow from '../components/orbit/WayRow.astro';
import Closing from '../components/orbit/Closing.astro';
import TextLink from '../components/orbit/TextLink.astro';

const ways = [
  { title: 'Initial conversation', description: 'Tell me what you are trying to accomplish and where the work is getting stuck.' },
  { title: 'Focused diagnostic', description: 'A focused engagement to understand the system and test the competing explanations.' },
  { title: 'Embedded product leadership', description: 'Hands-on senior leadership for a critical initiative or transition.' },
];

const areas = [
  'Product vision, strategy and positioning',
  'Product design and user research',
  'Product operations and organization design',
  'Coaching and mentoring',
];
---

<BaseLayout title="Work With Me" description="Product strategy, discovery, assessment, and fractional product leadership with Brandon Keao.">
  <OrbitStage set="work" size="small" still>
    <h1 slot="headline" class="t-page-title">Get unstuck.<br />Build momentum.</h1>
    <p class="t-lead muted-g" style="max-width:560px">I work with leadership teams when an important product or growth problem is not moving.</p>
  </OrbitStage>

  <Sheet label="Ways to work together">
    <p class="crumb">Ways to work together</p>
    <h2 class="t-section" style="margin-top:10px">Start with the problem.</h2>
    <div style="margin-top:28px">
      {ways.map((w) => <WayRow title={w.title} description={w.description} href="/contact" linkLabel="Let's talk" />)}
    </div>
  </Sheet>

  <section id="system" class="section-ground" aria-labelledby="help-title">
    <div class="row" style="align-items:flex-end">
      <h2 id="help-title" class="t-section col">The product is only one part of the system.</h2>
      <p class="t-lead muted-g col">I work across teams to solve customer and business problems.</p>
    </div>
    <div class="grid-4" style="margin-top:40px">
      {areas.map((a) => <div class="area"><h3 class="t-item">{a}</h3></div>)}
    </div>
  </section>

  <Sheet label="Working together">
    <div class="row">
      <div class="col"><h2 class="t-section">Clear expectations and honest feedback.</h2></div>
      <div class="col">
        <p class="t-lead">I believe leadership comes from everywhere. My job is to make the problem clear, remove what is in the way, and support the people doing the work.</p>
        <p style="margin-top:24px"><TextLink href="/manager-readme">Read my Manager README</TextLink></p>
      </div>
    </div>
  </Sheet>

  <Closing title="Tell me what you're trying to move." />
</BaseLayout>
