---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMotion from '../components/HeroMotion.astro';
import EmailContact from '../components/EmailContact.astro';
---

<BaseLayout title="Contact" description="Get in touch with Brandon Keao about product leadership, your team, or a project.">
  <section class="page-hero contact-hero">
    <div class="container">
      <h1 class="page-title">Let's talk</h1>
      <HeroMotion kind="connect" />
      <p class="page-dek">
        Whether you have a specific project in mind or just want to explore fit, I'd like to hear from you.
      </p>
    </div>
  </section>

  <section class="v2-section">
    <div class="container reveal">
      <div class="contact-methods">
        <EmailContact />
        <a
          class="contact-method"
          href="https://linkedin.com/in/brandonkeao"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>LinkedIn</span>
          <strong>/in/brandonkeao</strong>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="contact-note">
        I typically respond within 48 hours. If we're a good fit, we'll set up a discovery call.
      </p>
    </div>
  </section>
</BaseLayout>


<style>
  .contact-hero {
    background: #a9432c;
    border-bottom-color: #a9432c;
  }

  .contact-hero .page-dek {
    color: var(--bg-primary);
  }

  /* A short invitation needs less space than the longer page introductions. */
  @media (min-width: 721px) {
    .contact-hero {
      min-height: 0;
      padding-block: clamp(3.5rem, 8vh, 5rem);
    }
  }
</style>
