---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Brandon Keao. Let's talk about AI strategy, product leadership, or collaboration.">
  <section class="page-hero">
    <div class="container">
      <h1 class="page-title">Let's Talk</h1>
      <p class="page-dek">
        Whether you have a specific project in mind or just want to explore fit, I'd like to hear from you.
      </p>
    </div>
  </section>

  <section class="v2-section">
    <div class="container reveal">
      <div class="contact-methods">
        <a class="contact-method" href="mailto:brandon.keao@gmail.com">
          <span>Email</span>
          <strong>brandon.keao@gmail.com</strong>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="contact-method"
          href="https://linkedin.com/in/brandonkeao"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>LinkedIn</span>
          <strong>/in/brandonkeao</strong>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="contact-note">
        I typically respond within 48 hours. If we're a good fit, we'll set up a discovery call.
      </p>
    </div>
  </section>
</BaseLayout>
