---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container article-shell">
    <div class="article-inner">
      <a href="/writing" class="article-back">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Writing
      </a>

      <header class="article-header">
        <time class="article-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <h1 class="article-title">{post.data.title}</h1>
        {post.data.tags && (
          <div class="article-tags">
            {post.data.tags.map((tag: string) => <span>{tag}</span>)}
          </div>
        )}
      </header>

      <div class="prose article-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
