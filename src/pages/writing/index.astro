---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sheet from '../../components/orbit/Sheet.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing');
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title="Writing" description="Thoughts on context engineering, agentic systems, and the changing nature of product work. Building in public.">
  <header class="page-header">
    <h1 class="t-page-title">Writing</h1>
    <p class="t-lead muted-g" style="margin-top:18px;max-width:720px">
      I write about context engineering, agentic systems, and how product work is changing. Most of this starts on <a class="link-ground" href="https://linkedin.com/in/brandonkeao" target="_blank" rel="noopener noreferrer">LinkedIn</a> first.
    </p>
  </header>

  <Sheet label="Articles">
    <p class="crumb">{sortedPosts.length} {sortedPosts.length === 1 ? 'article' : 'articles'}</p>
    <div class="divider-list" style="margin-top:16px">
      {sortedPosts.map(post => (
        <article class="post-row">
          <time class="t-small muted-s" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <div>
            <h2 class="t-item"><a href={`/writing/${post.id}`}>{post.data.title}</a></h2>
            <p class="t-body muted-s" style="margin-top:8px">{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </Sheet>
</BaseLayout>

<style>
  .post-row { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 40px; padding: 26px 0; }
  .post-row h2 a:hover { color: var(--accent); }
  @media (max-width: 860px) { .post-row { grid-template-columns: minmax(0, 1fr); gap: 6px; padding: 20px 0; } }
</style>
