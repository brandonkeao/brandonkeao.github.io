---
import BaseLayout from '../layouts/BaseLayout.astro';

const companies = ['Bridgewater', 'Bloomberg', 'Bitly', 'Pie Insurance', 'Rebrandly'];

const capabilities = [
  {
    number: '01',
    title: 'Product vision, strategy & positioning',
    body: 'Clarify what to build, who it is for, why it matters, and how the team will turn the choice into a roadmap and go-to-market plan.'
  },
  {
    number: '02',
    title: 'Product design & user research',
    body: 'Understand real customer needs through interviews, journeys, usability testing, opportunity mapping, and evidence that improves the product.'
  },
  {
    number: '03',
    title: 'Product operations & team development',
    body: 'Improve the system around the work: team structure, analytics, coaching, hiring, communication, prioritization, and clear ownership.'
  }
];

const principles = [
  {
    number: '01 / 04',
    title: 'Understand',
    body: 'Start with customer and market needs. Map the system and make the problem clear enough to act on.'
  },
  {
    number: '02 / 04',
    title: 'Start',
    body: 'Starting is the best way to begin learning and make progress. Use judgment, but do not let endless debate become the work.'
  },
  {
    number: '03 / 04',
    title: 'Own',
    body: 'Leadership comes from everywhere. Own the problems in your world and make it easier for other people to lead.'
  },
  {
    number: '04 / 04',
    title: 'Improve',
    body: 'Give honest, timely feedback and continually fix small things. The compounding effect is how products, systems, and people grow.'
  }
];

const engagements = [
  {
    meta: 'Free · 30 minutes',
    title: 'Phone consultation',
    body: 'An initial conversation to understand what you need, see whether I can genuinely help, and decide if there is a useful next step.',
    symbol: '◎'
  },
  {
    meta: 'Up to 20 hours · Two weeks',
    title: 'Discovery and assessment',
    body: 'A focused engagement to understand the situation, explore the options, and create enough clarity to get unstuck and build momentum.',
    symbol: '↗'
  },
  {
    meta: 'Ongoing leadership',
    title: 'Fractional Head of Product',
    body: 'Product expertise, strategy, and leadership to define the vision, guide development, strengthen the team, and improve product-market fit.',
    symbol: '∞'
  }
];
---

<BaseLayout
  title="Product Leader, Builder & Advisor"
  description="Brandon Keao helps CEOs and founders scale product-led innovation and growth by deeply understanding customer and market needs."
>
  <section class="v2-hero">
    <div class="container v2-hero-grid">
      <div class="v2-hero-copy reveal">
        <div>
          <p class="kicker">Product leader, builder & advisor</p>
          <h1 class="v2-display">Helping CEOs and founders scale <em>product-led innovation and growth.</em></h1>
        </div>
        <p class="v2-lead">
          I do that by deeply understanding customer and market needs, building products people value, and helping teams move with transparency, trust, respect, and ownership.
        </p>
        <div class="v2-actions">
          <a class="btn btn-primary" href="/contact">Start a Conversation <span aria-hidden="true">↗</span></a>
          <a class="btn btn-secondary" href="#experience">See the experience <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <aside class="v2-note reveal">
        <strong>Builder first</strong>
        <p>I care about things that actually work: useful products, clear decisions, reliable systems, and teams with enough ownership to keep improving.</p>
      </aside>
    </div>
  </section>

  <section class="v2-proof" aria-label="Experience summary">
    <div class="container v2-proof-grid">
      <div class="v2-proof-stat">
        <b>18+</b>
        <span>years building products, teams, and complex systems</span>
      </div>
      <div class="v2-company-list">
        <small>Experience includes</small>
        {companies.map(company => <span>{company}</span>)}
      </div>
    </div>
  </section>

  <section class="v2-section" id="experience">
    <div class="container">
      <div class="v2-section-heading reveal">
        <p class="kicker">Where I help</p>
        <h2 class="v2-section-title">Get unstuck and build momentum.</h2>
      </div>
      <div class="v2-capabilities reveal-stagger">
        {capabilities.map(capability => (
          <article class="v2-capability">
            <span class="v2-number">{capability.number}</span>
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v2-section v2-dark">
    <div class="container">
      <div class="v2-split-heading reveal">
        <div>
          <p class="kicker">How I work</p>
          <h2 class="v2-section-title">The minimum process needed to be effective.</h2>
        </div>
        <p class="v2-lead">I often spend more time trying to remove processes than add them. The goal is enough structure to create clarity and ownership, then enough trust for people to lead from wherever they are.</p>
      </div>
      <div class="v2-principles reveal-stagger">
        {principles.map(principle => (
          <article class="v2-principle">
            <span>{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v2-section" aria-labelledby="proof-title">
    <div class="container">
      <div class="v2-section-heading reveal">
        <p class="kicker">Selected evidence</p>
        <div>
          <h2 class="v2-section-title" id="proof-title">Products, teams, and systems that work.</h2>
          <p class="v2-lead v2-heading-support">The original site carried the right proof points, but not enough of the story behind them. This version starts rebuilding that evidence.</p>
        </div>
      </div>
      <div class="v2-work-grid reveal-stagger">
        <article class="v2-work-card v2-work-card-featured">
          <div class="v2-work-meta"><span>SaaS · Product growth</span><span class="v2-review-label">Claim to verify</span></div>
          <div>
            <h3>Helping Bitly scale its core SaaS business.</h3>
            <p>The original site stated that Bitly's SaaS revenue increased 75% on my watch. The next pass should recover the decisions, team contribution, and product work behind that result.</p>
          </div>
        </article>
        <article class="v2-work-card">
          <div class="v2-work-meta"><span>18+ years · Technology</span><span class="v2-review-label">Story to develop</span></div>
          <div>
            <h3>Working across the full product cycle.</h3>
            <p>Consulting, research, design, product strategy, team leadership, operations, and growth across established and scaling companies.</p>
          </div>
        </article>
        <a class="v2-work-card" href="/manager-readme">
          <div class="v2-work-meta"><span>Leadership · Working together</span><span class="v2-review-label">Recovered in full</span></div>
          <div>
            <h3>A management philosophy designed to be used.</h3>
            <p>Clear expectations for feedback, development, ownership, positive intent, systems thinking, and service to the team.</p>
          </div>
          <span class="v2-card-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="v2-section v2-services" id="work-with-me">
    <div class="container">
      <div class="v2-section-heading reveal">
        <p class="kicker">How to work together</p>
        <h2 class="v2-section-title">Start with what will help you move.</h2>
      </div>
      <div class="v2-engagements reveal-stagger">
        {engagements.map((engagement, index) => (
          <article class="v2-engagement">
            <span class="v2-number">0{index + 1}</span>
            <div>
              <span class="v2-engagement-meta">{engagement.meta}</span>
              <h3>{engagement.title}</h3>
            </div>
            <p>{engagement.body}</p>
            <span class="v2-engagement-symbol" aria-hidden="true">{engagement.symbol}</span>
          </article>
        ))}
      </div>
      <a class="text-link" href="/services">See how we can work together <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="v2-section v2-quote">
    <div class="container reveal">
      <blockquote>“Finding someone who can translate business objectives into technical requirements is difficult. Finding someone who can also own the project, teams, and client relationship is rare.”</blockquote>
      <cite>Andre Sugai · CTO and Partner, Ora Interactive</cite>
    </div>
  </section>

  <section class="v2-section" id="thinking">
    <div class="container v2-thinking-grid">
      <div class="reveal">
        <p class="kicker">Thinking</p>
        <h2 class="v2-section-title">How I think, lead, and keep learning.</h2>
        <p class="v2-lead v2-heading-support">The original site made room for a blog, a Manager README, and a bookshelf. Together they show the ideas, values, and inputs behind the work.</p>
      </div>
      <div class="v2-link-list reveal-stagger">
        <a href="/writing"><span>Writing</span><strong>Ideas from the work</strong><span aria-hidden="true">↗</span></a>
        <a href="/manager-readme"><span>Working together</span><strong>Manager README</strong><span aria-hidden="true">↗</span></a>
        <a href="/bookshelf"><span>Inputs</span><strong>Bookshelf</strong><span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="v2-section v2-about">
    <div class="container v2-about-grid reveal">
      <div>
        <p class="kicker">About Brandon</p>
        <h2 class="v2-section-title">A builder who cares about things that actually work.</h2>
      </div>
      <div>
        <p class="v2-lead">I have an engineering degree from Northwestern University and 18+ years in technology spanning consulting, product, design, research, and strategy.</p>
        <p>My current work adds AI, data, and new ways of working to that foundation. The durable part is the same: understand the system, make a clear choice, build alongside the team, and be honest about what the evidence says next.</p>
        <a class="text-link" href="/about">More about me <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="v2-section v2-contact">
    <div class="container reveal">
      <p class="kicker">Start a conversation</p>
      <h2>If you're stuck, let's talk about what would create momentum.</h2>
      <a class="btn btn-primary" href="/contact">Tell me what you need <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
