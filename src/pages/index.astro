---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrbitStage from '../components/orbit/OrbitStage.astro';
import Sheet from '../components/orbit/Sheet.astro';
import StepList from '../components/orbit/StepList.astro';
import WayRow from '../components/orbit/WayRow.astro';
import Quote from '../components/orbit/Quote.astro';
import Closing from '../components/orbit/Closing.astro';
import ExperienceStrip from '../components/orbit/ExperienceStrip.astro';
import { SETS } from '../lib/orbit/orbit-data';

const ways = SETS.home;
const meta = ['Diagnostic', 'Strategic initiative', 'Fractional leadership'];
const first = ways[0];

const clients = ['Rebrandly', 'Pie Insurance', 'Bitly', 'PAIRIN', 'Ora Interactive', 'Sears', 'Bridgewater', 'Bloomberg', 'Goldman Sachs', 'Deutsche Bank', 'Capital Group', 'Thomson Reuters', 'Saxo Bank'];

const covers = ['inspired', 'empowered', 'continuous-discovery-habits', 'escaping-the-build-trap', 'high-output-management'];

const process = [
  { title: 'Understand', body: 'Start with customer and market needs. Map the system and make the problem clear enough to act on.' },
  { title: 'Start', body: 'Starting is the best way to begin learning and make progress. Use judgment, but do not let endless debate become the work.' },
  { title: 'Own', body: 'Leadership comes from everywhere. Own the problems in your world and make it easier for other people to lead.' },
  { title: 'Improve', body: 'Give honest, timely feedback and keep fixing small things. The small fixes add up.' },
];
import HeroMeteor from '../components/orbit/HeroMeteor.astro';
---

<BaseLayout
  title="Senior product leadership making outcomes move."
  description="I work with leadership teams when an important product or growth problem is not moving. Background in engineering, consulting, and product leadership."
>
  <OrbitStage set="home" size="closeup" controls="none" speed={2}>
    <h1 slot="headline" class="t-display">Senior product<br /> leadership making<br /> outcomes move.</h1>
    <HeroMeteor slot="headline" />
    <p class="t-lead muted-g">Senior enough to shape the direction. Close enough to the work to help make it happen.</p>
    <div style="display:flex;gap:20px;align-items:center;margin-top:28px;flex-wrap:wrap">
      <a href="/services/" class="btn btn-brand">Work with me</a>
      <a href="/contact/" class="link-ground">Let's talk</a>
    </div>
  </OrbitStage>

  <ExperienceStrip names={clients} />

  <Sheet id="way-in" label="Selected way in">
    <p class="crumb">Your outcome › <b data-orbit-title>{first.name}</b></p>
    <div class="row" style="margin-top:18px">
      <div class="col">
        <p data-orbit-body style="font-size:clamp(20px,1.7vw,24px);line-height:1.42;letter-spacing:-0.01em">{first.summary}</p>
        <p style="margin-top:28px"><a class="link-sheet" href="/services/">See how we can work together</a></p>
      </div>
      <div class="col"><StepList steps={first.items} data-orbit-steps /></div>
    </div>
  </Sheet>

  <section class="section-ground" aria-label="Proof" data-proof>
    <div style="max-width:960px">
      <Quote
        quote="“Finding someone who can translate business objectives into technical requirements is difficult. Finding someone who can also own the project, teams, and client relationship is rare.”"
        cite="Andre Sugai, CTO and Partner, Ora Interactive"
      />
    </div>
  </section>

  <Sheet label="Ways to work together">
    <h2 class="t-section">Ways to work together</h2>
    <div style="margin-top:28px">
      {ways.map((w, i) => (
        <WayRow meta={meta[i]} title={w.name} description={w.summary} href="/services/" linkLabel="How it works" dot={(i + 1) as 1 | 2 | 3} />
      ))}
    </div>
  </Sheet>

  <Sheet label="Where my approach comes from">
    <div class="row">
      <div class="col">
        <h2 class="t-section">Where my approach comes from.</h2>
        <p class="t-lead muted-s" style="margin-top:18px;max-width:520px">My Manager README says how I work with a team. My Bookshelf lists many of the ideas behind it.</p>
      </div>
      <div class="col stack divider-list">
        <div style="padding:24px 0;display:flex;justify-content:space-between;align-items:center;gap:16px">
          <div><p class="t-caption muted-s">How I work with a team</p><h3 class="t-title">Manager README</h3></div>
          <a class="link-sheet" href="/manager-readme/">Read it</a>
        </div>
        <div style="padding:24px 0;display:flex;justify-content:space-between;align-items:center;gap:16px">
          <div>
            <p class="t-caption muted-s">Ideas and influences</p>
            <h3 class="t-title">Bookshelf</h3>
            <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
              {covers.map((c) => <img src={`/images/books/${c}.jpg`} alt="" width="64" height="96" loading="lazy" style="height:96px;width:auto;border-radius:2px" />)}
            </div>
          </div>
          <a class="link-sheet" href="/bookshelf/">Browse</a>
        </div>
      </div>
    </div>
  </Sheet>

  <Sheet label="About">
    <div class="row" style="align-items:center">
      <img class="portrait" src="/images/brandon-keao-headshot.jpg" alt="Brandon Keao" width="300" height="300" loading="lazy" style="width:min(300px,100%);height:auto;aspect-ratio:1" />
      <div class="col">
        <h2 class="t-section">A builder who cares about things that actually work.</h2>
        <p class="t-lead" style="margin-top:18px">I have an engineering degree from Northwestern University and 18+ years in technology spanning consulting, product, design, research, and strategy.</p>
        <p class="t-body muted-s" style="margin-top:12px">That foundation shapes how I work with AI and data today: understand the problem, decide what to try, build alongside the team, and check whether it helped.</p>
        <p style="margin-top:24px"><a class="link-sheet" href="/about/">More about me</a></p>
      </div>
    </div>
  </Sheet>

  <section class="section-ground" aria-labelledby="process-title">
    <h2 id="process-title" class="t-section" style="max-width:700px">The minimum process needed to be effective.</h2>
    <div class="grid-4" style="margin-top:40px">
      {process.map((p) => (
        <div class="area">
          <h3 class="t-item">{p.title}</h3>
          <p class="t-small muted-g" style="margin-top:10px">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    // Home always opens at the top (Brandon, 2026-10-06), including reload and back/forward.
    // Runs before the view-transition router restores a saved position, so there is no jump.
    (function () {
      if (location.pathname !== '/' || location.hash) return;
      history.scrollRestoration = 'manual';
      if (history.state) history.replaceState(Object.assign({}, history.state, { scrollX: 0, scrollY: 0 }), '');
      scrollTo(0, 0);
      if (window.__homeTop) return;
      window.__homeTop = true;
      var top = function () {
        if (location.pathname === '/' && !location.hash) scrollTo({ left: 0, top: 0, behavior: 'instant' });
      };
      document.addEventListener('astro:after-swap', top);
      document.addEventListener('astro:page-load', top);
    })();
  </script>

  <Closing title="If you're stuck, let's talk about what to try first." />
</BaseLayout>
