---
// The real 404 (website #2, runbook B2). Vercel serves dist/404.html for any unmatched path;
// GitHub Pages does the same. The hero carries no mark, like Manager README, so the page is
// calm: a title, one line, and the two ways on.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/orbit/PageHero.astro';
import Button from '../components/orbit/Button.astro';
---

<BaseLayout title="Page not found" description="That page isn't here. It may have moved, or the address may be off by a character." noindex>
  <PageHero title="Page not found" lead="That page isn't here. It may have moved, or the address may be off by a character.">
    <nav class="not-found-links" aria-label="Ways on">
      <Button href="/">Home</Button>
      <Button href="/contact/" variant="outline">Let's talk</Button>
    </nav>
  </PageHero>
</BaseLayout>

<style>
  .not-found-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
</style>
