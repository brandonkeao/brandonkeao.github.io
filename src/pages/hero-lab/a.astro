---
// Hero lab, option A · Standard: text and action first. A still rule, the proof closing the first
// screen. Copy is a labelled DRAFT (the meta description as the headline); the current headline
// and lead are the alternative. Not for production; noindex; the lab branch is never merged.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/orbit/PageHero.astro';
import ExperienceStrip from '../../components/orbit/ExperienceStrip.astro';
import HomeRest from '../../components/hero-lab/HomeRest.astro';
import { COMPANIES, LINKEDIN, DESCRIPTION } from '../../components/hero-lab/data';
---

<BaseLayout title="Hero lab A" description={DESCRIPTION} noindex>
  <PageHero
    title="I help teams build momentum toward better customer and business outcomes."
    mark="momentum"
    lead="Senior product leadership with a background in engineering and consulting. Senior enough to shape the direction. Close enough to the work to help make it happen."
    class="hv-hero hero-a"
  >
    <div class="hv-hero-actions">
      <a href="/services/" class="btn btn-brand">Work with me</a>
      <a href={LINKEDIN} class="link-ground" rel="noopener">See my experience</a>
    </div>
  </PageHero>

  <ExperienceStrip surface="ground" names={COMPANIES} />

  <HomeRest />
</BaseLayout>

<style is:global>
  /* A: the line is still. The momentum mark shows its finished state; nothing draws. */
  .hero-a .hero-line .hero-rule { animation: none !important; transform: none !important; }
  .hero-a .motion-line .ml-draw { animation: none !important; stroke-dashoffset: 0 !important; }
  .hero-a .motion-line .ml-traveller { animation: none !important; opacity: 0 !important; }
  .hero-a .motion-line .ml-resolve { animation: none !important; opacity: 1 !important; }
  /* A: the proof closes the first screen tighter (hero step 64 → 40, strip top 24 → 16). */
  .hero-a.page-header { padding-bottom: 40px; }
  .hero-a + section.experience--ground { padding-top: 16px; }
</style>
